$mem = @import("std/mem");
$debug = @import("std/debug");

pub @func main() {
    # Memory size is 1024 * 1024 slots.
    # If we allocate 10,000 slots 200 times, it requires ~2M slots which exceeds the 1MB limit.
    # Even if we deinit() in every loop iteration, it will crash with OutOfMemory if the chunks aren't reclaimed.
    
    debug.printLn("Starting loop...");
    @for(0..200) |i| {
        $a = mem.create(10000);
        a.deinit();
    }
    debug.printLn("Loop completed successfully!");
}
