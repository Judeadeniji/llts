@const $fs = @import("std/fs.lls");
@const $string = @import("std/string.lls");
@const $debug = @import("std/debug.lls");
@const $mem = @import("std/mem.lls");
@const $scanner = @import("scanner/root.lls");
@const $parser = @import("parser/root.lls");

@func main() {
    debug.printLn("Starting main");
    # Pass arena: tokens and other heap that must outlive nextToken's frame.
    $arena = mem.create(0);
    defer arena.deinit();

    $src = fs.readFile("examples/hello-world.lls");
    debug.printLn("Read file, length = {i}", string.len(src));
    
    $doc = parser.parse(arena, src, "examples/hello-world.lls");
    debug.printLn("Parsed document. It has {i} statements.", len(doc.statements));
}
