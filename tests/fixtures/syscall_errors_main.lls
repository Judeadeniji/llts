@const $sys = @import("std/syscall");

pub @func main() {
    $missing = sys.io.open_read(".tmpdir/llts_syscall_missing.txt");
    @if (@isError(missing)) {
        print("open-failed");
    } @else {
        print("unexpected-open");
    }

    $buf = @zeroed([4]u8);
    $empty = sys.io.read(sys.core.STDIN, buf[0..0])?;
    print(empty);
}
