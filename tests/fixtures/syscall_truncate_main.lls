@const $sys = @import("std/syscall");

pub @func main() {
    $path = ".tmpdir/llts_syscall_truncate.dat";

    $file = sys.io.open_write(path)?;
    sys.io.write_all(file, "abcdef")?;
    sys.io.truncate_file(file, 3)?;
    sys.io.close(file)?;

    $input = sys.io.open_read(path)?;
    $size = sys.io.seek(input, 0, sys.io.SeekWhence.End)?;
    _ = sys.io.seek(input, 0, sys.io.SeekWhence.Set)?;
    $buf: [8]u8 = [0, 0, 0, 0, 0, 0, 0, 0];
    $n = sys.io.read(input, buf[..])?;
    sys.io.close(input)?;
    sys.io.unlink(path)?;

    print(size);
    print(n);
    print(@as(i64, buf[2]));
    print(@as(i64, buf[3]));
}
