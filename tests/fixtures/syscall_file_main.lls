@const $sys = @import("std/syscall");

pub @func main() {
    $path = ".tmpdir/llts_syscall_test.dat";

    $file = sys.io.open_write(path)?;
    sys.io.write_all(file, "hello libc")?;
    sys.io.close(file)?;

    $input = sys.io.open_read(path)?;
    $offset = sys.io.seek(input, 6, sys.io.SeekWhence.Set)?;
    $buf = @zeroed([4]u8);
    $n = sys.io.read(input, buf[..])?;
    sys.io.close(input)?;
    sys.io.unlink(path)?;

    print(offset);
    print(n);
    print(@as(i64, buf[0]));
    print(@as(i64, buf[3]));
}
