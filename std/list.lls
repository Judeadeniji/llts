# Arena-backed growable list. Storage is reclaimed with `arena.reset()` / `deinit()`.
# The list handle is invalid after the arena is reset.
# `createImmortal` is process-lifetime only (fs/io escape hatch) — prefer `create(arena)`.
#
# Element slots are dynamically typed (`unknown`) because a list may hold any
# value; `pop` / `get` return `unknown` for the same reason.

@const $mem = @import("./mem.lls");

# Handle for a packed value array living in the VM byte heap.
pub @type ArrayRef = {
    offset: u32;
    count: u32;
    capacity: u32;
    arena_ctrl: i32;
    arena_gen: i32;
};

pub @struct List {
    arena_ctrl: i32;
    arena_gen: i32;
    items: ArrayRef;
}

pub @func create(arena: mem.Arena): *List {
    return @as(*List, __listCreate(arena));
}

# Process-lifetime; never reclaimed by arena reset. Prefer create(arena).
pub @func createImmortal(): *List {
    return @as(*List, __listCreateImmortal());
}

pub @func push(lst: *List, item: unknown): *List {
    return @as(*List, __listPush(lst, item));
}

pub @func pop(lst: *List): unknown {
    return __listPop(lst);
}

pub @func get(lst: *List, index: int): unknown {
    return __listGet(lst, index);
}

pub @func set(lst: *List, index: int, item: unknown): unknown {
    return __listSet(lst, index, item);
}

pub @func len(lst: *List): int {
    return @as(int, __listLen(lst));
}


