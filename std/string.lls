pub @func len(str: string): int {
    return @as(int, __strlen(str));
}

pub @func concat(a: string, b: string): string {
    return @as(string, __concat(a, b));
}

pub @func substr(str: string, start: int, length: int): string {
    return @as(string, __substr(str, start, length));
}

pub @func indexOf(str: string, search: string): int {
    return @as(int, __indexOf(str, search));
}

pub @func split(str: string, sep: string): []string {
    return @as([]string, __split(str, sep));
}

pub @func toUpper(str: string): string {
    return @as(string, __toUpper(str));
}

pub @func toLower(str: string): string {
    return @as(string, __toLower(str));
}

pub @func trim(str: string): string {
    return @as(string, __trim(str));
}

pub @func replace(str: string, search: string, replacement: string): string {
    return @as(string, __replace(str, search, replacement));
}

pub @func repeat(str: string, count: int): string {
    return @as(string, __repeat(str, count));
}

pub @func startsWith(str: string, search: string): bool {
    return @as(bool, __startsWith(str, search));
}

pub @func endsWith(str: string, search: string): bool {
    return @as(bool, __endsWith(str, search));
}

pub @func charCodeAt(str: string, index: int): int {
    return @as(int, __charCodeAt(str, index));
}

pub @func parseInt(str: string, base: int): int {
    return @as(int, __parseInt(str, base));
}

pub @func parseFloat(str: string): float {
    return @as(float, __parseFloat(str));
}

pub @func fromCharCode(code: int): string {
    return @as(string, __fromCharCode(code));
}

pub @func contains(str: string, search: string): bool {
    return @as(bool, __contains(str, search));
}

pub @func lastIndexOf(str: string, search: string): int {
    return @as(int, __lastIndexOf(str, search));
}

pub @func indexOfFrom(str: string, search: string, from: int): int {
    return @as(int, __indexOfFrom(str, search, from));
}

pub @func trimStart(str: string): string {
    return @as(string, __trimStart(str));
}

pub @func trimEnd(str: string): string {
    return @as(string, __trimEnd(str));
}

pub @func replaceFirst(str: string, search: string, replacement: string): string {
    return @as(string, __replaceFirst(str, search, replacement));
}

pub @func slice(str: string, start: int, end: int): string {
    return @as(string, __slice(str, start, end));
}

pub @func compare(a: string, b: string): int {
    return @as(int, __compare(a, b));
}

pub @func eql(a: string, b: string): bool {
    return @as(bool, __eql(a, b));
}

pub @func splitMax(str: string, sep: string, n: int): []string {
    return @as([]string, __splitMax(str, sep, n));
}

pub @func join(arr: []string, sep: string): string {
    return @as(string, __join(arr, sep));
}

pub @func padStart(str: string, len: int, pad: string): string {
    return @as(string, __padStart(str, len, pad));
}

pub @func padEnd(str: string, len: int, pad: string): string {
    return @as(string, __padEnd(str, len, pad));
}

pub @func isEmpty(str: string): bool {
    return @as(bool, __isEmpty(str));
}

pub @func isBlank(str: string): bool {
    return @as(bool, __isBlank(str));
}
