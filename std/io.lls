# Stdio — stdin / stdout / stderr as File handles over std/syscall.
# Path I/O lives in std/fs.
#
# Usage:
#   io.stdout.writeAll("hello\n");
#   io.eprintln("fail");
#   $line = io.stdin.readLine();

@const $syscall = @import("./syscall.lls");
@const $buffer = @import("./buffer.lls");
@const $mem = @import("./mem.lls");

pub @struct File {
    fd: int;

    @func write(self: *File, data: string): unknown {
        return write(self.fd, data);
    }

    @func writeAll(self: *File, data: string): unknown {
        return writeAll(self.fd, data);
    }

    @func read(self: *File, buf: *buffer.Buffer): unknown {
        return read(self.fd, buf);
    }

    @func readLine(self: *File): string {
        return readLineFd(self.fd);
    }

    @func flush(self: *File): unknown {
        return syscall.fsync(self.fd);
    }
}

pub $stdin = File{ fd: syscall.STDIN_FILENO };
pub $stdout = File{ fd: syscall.STDOUT_FILENO };
pub $stderr = File{ fd: syscall.STDERR_FILENO };

pub @func fromFd(arena: mem.Arena, fd: int): *File {
    $f = @new(arena, File);
    f.fd = fd;
    return f;
}

# --- fd operations ---

pub @func write(fd: int, data: string): unknown {
    return syscall.write(fd, data);
}

pub @func writeAll(fd: int, data: string): unknown {
    return syscall.writeAll(fd, data);
}

pub @func read(fd: int, buf: *buffer.Buffer): unknown {
    return syscall.read(fd, buf);
}

pub @func readLineFd(fd: int): string {
    return @as(string, __readLine(fd));
}

# --- convenience (stdout / stderr / stdin) ---

pub @func readLine(): string {
    return @as(string, stdin.readLine());
}

pub @func print(data: string): unknown {
    return stdout.writeAll(data);
}

pub @func eprint(data: string): unknown {
    return stderr.writeAll(data);
}

# Dynamic-error-channel boundary: the syscall result is `unknown` until
# `@isError` narrows it, so the local must be annotated.
pub @func println(data: string): unknown {
    $rc: unknown = stdout.writeAll(data);
    @if (@isError(rc)) {
        return rc;
    }
    return stdout.writeAll("\n");
}

pub @func eprintln(data: string): unknown {
    $rc: unknown = stderr.writeAll(data);
    @if (@isError(rc)) {
        return rc;
    }
    return stderr.writeAll("\n");
}

# Drain stdin until EOF into a string.
# Uses createImmortal (process-lifetime) so the result outlives the scratch arena.
pub @func readAll(): string {
    $scratch = mem.create(0);
    $chunk = buffer.alloc(scratch, 8192);
    $out = buffer.createImmortal();
    @for (0..1000000) |i| {
        $n: unknown = stdin.read(chunk);
        @if (!@isError(n)) {
            @if (@as(int, n) == 0) {
                break;
            }
            buffer.appendString(out, buffer.readString(chunk, 0, @as(int, n)));
        } @else {
            scratch.deinit();
            return @as(string, n);
        }
    }
    scratch.deinit();
    return buffer.readString(out, 0, buffer.len(out));
}
