# Package slog provides structured logging with levels and attributes.
# This module re-exports the full 1:1 Go slog implementation from std/log/slog.lls.

@const $slog = @import("std/log/slog.lls");

# --- Levels ---
pub @const $levelDebug = slog.levelDebug;
pub @const $LevelDebug = slog.LevelDebug;
pub @const $levelInfo = slog.levelInfo;
pub @const $LevelInfo = slog.LevelInfo;
pub @const $levelWarn = slog.levelWarn;
pub @const $LevelWarn = slog.LevelWarn;
pub @const $levelError = slog.levelError;
pub @const $LevelError = slog.LevelError;
pub @const $levelString = slog.levelString;

# --- LevelVar ---
pub @const $LevelVar = slog.LevelVar;
pub @const $newLevelVar = slog.newLevelVar;

# --- Kinds ---
pub @const $kindAny = slog.kindAny;
pub @const $KindAny = slog.KindAny;
pub @const $kindBool = slog.kindBool;
pub @const $KindBool = slog.KindBool;
pub @const $kindDuration = slog.kindDuration;
pub @const $KindDuration = slog.KindDuration;
pub @const $kindFloat64 = slog.kindFloat64;
pub @const $KindFloat64 = slog.KindFloat64;
pub @const $kindInt64 = slog.kindInt64;
pub @const $KindInt64 = slog.KindInt64;
pub @const $kindString = slog.kindString;
pub @const $KindString = slog.KindString;
pub @const $kindTime = slog.kindTime;
pub @const $KindTime = slog.KindTime;
pub @const $kindUint64 = slog.kindUint64;
pub @const $KindUint64 = slog.KindUint64;
pub @const $kindGroup = slog.kindGroup;
pub @const $KindGroup = slog.KindGroup;
pub @const $kindLogValuer = slog.kindLogValuer;
pub @const $KindLogValuer = slog.KindLogValuer;

# --- Values ---
pub @const $Value = slog.Value;
pub @const $stringValue = slog.stringValue;
pub @const $intValue = slog.intValue;
pub @const $int64Value = slog.int64Value;
pub @const $uint64Value = slog.uint64Value;
pub @const $float64Value = slog.float64Value;
pub @const $boolValue = slog.boolValue;
pub @const $durationValue = slog.durationValue;
pub @const $timeValue = slog.timeValue;
pub @const $groupValue = slog.groupValue;
pub @const $anyValue = slog.anyValue;

# --- Attrs ---
pub @const $Attr = slog.Attr;
pub @const $stringAttr = slog.stringAttr;
pub @const $intAttr = slog.intAttr;
pub @const $uint64Attr = slog.uint64Attr;
pub @const $float64Attr = slog.float64Attr;
pub @const $boolAttr = slog.boolAttr;
pub @const $durationAttr = slog.durationAttr;
pub @const $timeAttr = slog.timeAttr;
pub @const $anyAttr = slog.anyAttr;
pub @const $groupAttr = slog.groupAttr;

# --- Record & Source ---
pub @const $Source = slog.Source;
pub @const $Record = slog.Record;
pub @const $newRecord = slog.newRecord;

# --- Handlers ---
pub @const $HandlerOptions = slog.HandlerOptions;
pub @const $Handler = slog.Handler;
pub @const $newTextHandler = slog.newTextHandler;
pub @const $newJSONHandler = slog.newJSONHandler;
pub @const $discardHandler = slog.discardHandler;

# --- Logger & Global functions ---
pub @const $Logger = slog.Logger;
pub @const $new = slog.new;
pub @const $defaultLogger = slog.defaultLogger;
pub @const $default = slog.default;
pub @const $setDefault = slog.setDefault;
pub @const $with = slog.with;
pub @const $log = slog.log;
pub @const $logAttrs = slog.logAttrs;
pub @const $debug = slog.debug;
pub @const $info = slog.info;
pub @const $warn = slog.warn;
pub @const $err = slog.err;
pub @const $assert = slog.assert;
