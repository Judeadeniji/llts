pub @func alloc(size) {
    return __bufferAlloc(size);
}

pub @func create() {
    return __bufferCreate();
}

pub @func fromString(str) {
    return __bufferFromString(str);
}

pub @func writeString(buf, offset, str) {
    return __bufferWriteString(buf, offset, str);
}

pub @func appendString(buf, str) {
    return __bufferAppendString(buf, str);
}

pub @func readString(buf, offset, len) {
    return __bufferReadString(buf, offset, len);
}

pub @func len(buf) {
    return __bufferLen(buf);
}

pub @func get(buf, index) {
    return __bufferGet(buf, index);
}

pub @func set(buf, index, val) {
    return __bufferSet(buf, index, val);
}

pub @func push(buf, val) {
    return __bufferPush(buf, val);
}

pub @func copy(dst, dst_off, src, src_off, len) {
    return __bufferCopy(dst, dst_off, src, src_off, len);
}

pub @func fill(buf, val) {
    return __bufferFill(buf, val);
}

pub @func fillRange(buf, val, start, len) {
    return __bufferFillRange(buf, val, start, len);
}

pub @func resize(buf, new_len) {
    return __bufferResize(buf, new_len);
}
