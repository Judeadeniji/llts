# Arena-backed byte buffer. Reclaimed with `arena.reset()` / `deinit()`.
# `createImmortal` is process-lifetime only (fs/io escape hatch) — prefer `create(arena)`.
#
# `Buffer` is the runtime handle (mirrors the VM's BufferObject layout). Pass it
# by pointer between calls; it is invalid after the owning arena is reset.

@const $mem = @import("./mem.lls");

# Growable packed byte view living in the VM byte heap.
pub @type BytesRef = {
    offset: u32;
    len: u32;
    capacity: u32;
};

pub @struct Buffer {
    arena_ctrl: i32;
    arena_gen: i32;
    data: BytesRef;

    @func deinit(self: *Buffer, allocator: mem.Arena) {
        _ = self;
        _ = allocator;
    }
}

pub @func alloc(arena: mem.Arena, size: int): *Buffer {
    return @as(*Buffer, __bufferAlloc(arena, size));
}

pub @func create(arena: mem.Arena): *Buffer {
    return @as(*Buffer, __bufferCreate(arena));
}

pub @func createImmortal(): *Buffer {
    return @as(*Buffer, __bufferCreateImmortal());
}

pub @func fromString(arena: mem.Arena, str: string): *Buffer {
    return @as(*Buffer, __bufferFromString(arena, str));
}

# Write `str` at `offset`; returns the number of bytes written.
pub @func writeString(buf: *Buffer, offset: int, str: string): int {
    return @as(int, __bufferWriteString(buf, offset, str));
}

# Append `str`; returns the number of bytes appended.
pub @func appendString(buf: *Buffer, str: string): int {
    return @as(int, __bufferAppendString(buf, str));
}

pub @func readString(buf: *Buffer, offset: int, len: int): string {
    return @as(string, __bufferReadString(buf, offset, len));
}

pub @func len(buf: *Buffer): int {
    return @as(int, __bufferLen(buf));
}

pub @func get(buf: *Buffer, index: int): int {
    return @as(int, __bufferGet(buf, index));
}

pub @func set(buf: *Buffer, index: int, val: int) {
    __bufferSet(buf, index, val);
}

pub @func push(buf: *Buffer, val: int) {
    __bufferPush(buf, val);
}

pub @func copy(dst: *Buffer, dst_off: int, src: *Buffer, src_off: int, len: int) {
    __bufferCopy(dst, dst_off, src, src_off, len);
}

pub @func fill(buf: *Buffer, val: int) {
    __bufferFill(buf, val);
}

pub @func fillRange(buf: *Buffer, val: int, start: int, len: int) {
    __bufferFillRange(buf, val, start, len);
}

pub @func resize(buf: *Buffer, new_len: int) {
    __bufferResize(buf, new_len);
}
