pub @func add(a: int, b: int): int {
    return a + b;
}

pub @func sub(a: int, b: int): int {
    return a - b;
}

pub @func mul(a: int, b: int): int {
    return a * b;
}

pub @func div(a: int, b: int): int {
    return a / b;
}

pub @func mod(a: int, b: int): int {
    return a % b;
}

pub @func pow(a: float, b: float): int {
    return @as(int, __pow(a, b));
}

pub @func sqr(a: float): int {
    return @as(int, __pow(a, 2));
}

pub @func abs(a: int): int {
    @if (a < 0) { return -a; }
    return a;
}

pub @func floor(a: float): int {
    return @as(int, __floor(a));
}

pub @func ceil(a: float): int {
    return @as(int, __ceil(a));
}

pub @func round(a: float): int {
    return @as(int, __round(a));
}

# `sqrt` of a negative number returns an error value, so the success type is
# deliberately left `unknown` (the error union cannot be named in a cast yet).
pub @func sqrt(a: float): unknown {
    return __sqrt(a);
}

# min/max: rest args are packed into an array; host natives unpack it.
pub @func min(...args: float): float {
    return @as(float, __min(args));
}

pub @func max(...args: float): float {
    return @as(float, __max(args));
}

pub @const $PI = 3.141592653589793;
pub @const $E = 2.718281828459045;

pub @func random(): float {
    return @as(float, __random());
}

pub @func sin(a: float): float {
    return @as(float, __sin(a));
}

pub @func cos(a: float): float {
    return @as(float, __cos(a));
}

pub @func tan(a: float): float {
    return @as(float, __tan(a));
}

pub @func asin(a: float): float {
    return @as(float, __asin(a));
}

pub @func acos(a: float): float {
    return @as(float, __acos(a));
}

pub @func atan(a: float): float {
    return @as(float, __atan(a));
}

pub @func atan2(y: float, x: float): float {
    return @as(float, __atan2(y, x));
}

pub @func log(a: float): float {
    return @as(float, __log(a));
}

pub @func log10(a: float): float {
    return @as(float, __log10(a));
}

pub @func log2(a: float): float {
    return @as(float, __log2(a));
}

pub @func exp(a: float): float {
    return @as(float, __exp(a));
}

pub @func cbrt(a: float): float {
    return @as(float, __cbrt(a));
}

pub @func trunc(a: float): float {
    return @as(float, __trunc(a));
}

pub @func sign(a: float): int {
    return @as(int, __sign(a));
}

