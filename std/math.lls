# C math.h classification / error constants (glibc values).
pub @const $FP_NAN = 0;
pub @const $FP_INFINITE = 1;
pub @const $FP_ZERO = 2;
pub @const $FP_SUBNORMAL = 3;
pub @const $FP_NORMAL = 4;
pub @const $MATH_ERRNO = 1;
pub @const $MATH_ERREXCEPT = 2;
pub @const $math_errhandling = 3;

