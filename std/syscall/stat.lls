# File metadata, file status, permissions, and timestamps.
#
# Provides idiomatic, safe LLTS wrappers around POSIX / glibc stat family calls:
#   stat, fstat, lstat, fstatat
#   statfs, fstatfs, statvfs, fstatvfs
#   chmod, fchmod, fchmodat
#   chown, fchown, lchown, fchownat
#   utimensat, futimens
#   mknod, mknodat, mkfifo, mkfifoat
#
# All path-accepting functions allocate a temporary NUL-terminated CBuffer and
# ensure it is freed with `defer c.free(buf)`.

@const $c = @import("std/syscall/c");
@const $core = @import("std/syscall/core");

# Re-exported types for public consumption
pub @alias Timespec = c.Timespec;
pub @alias TimePair = c.TimePair;
pub @alias Stat = c.Stat;
pub @alias Statfs = c.Statfs;
pub @alias Statvfs = c.Statvfs;

# Standard dirfd constants
pub @const $AT_FDCWD: core.Fd = @as(core.Fd, c.AT_FDCWD);
pub @const $AT_SYMLINK_NOFOLLOW: i32 = c.AT_SYMLINK_NOFOLLOW;

# Timestamp modification flags for utimensat / futimens
pub @const $UTIME_NOW: i64 = c.UTIME_NOW;
pub @const $UTIME_OMIT: i64 = c.UTIME_OMIT;

# File type bitmask and mode constants defined by POSIX / sys/stat.h
pub @const $S_IFMT: u32 = 0o170000;    # file type bitmask
pub @const $S_IFSOCK: u32 = 0o140000;  # socket
pub @const $S_IFLNK: u32 = 0o120000;   # symbolic link
pub @const $S_IFREG: u32 = 0o100000;   # regular file
pub @const $S_IFBLK: u32 = 0o060000;   # block device
pub @const $S_IFDIR: u32 = 0o040000;   # directory
pub @const $S_IFCHR: u32 = 0o020000;   # character device
pub @const $S_IFIFO: u32 = 0o010000;   # FIFO / named pipe

# Predicates to inspect file types from st_mode
pub @func is_regular(mode: u32): bool {
    return (mode & S_IFMT) == S_IFREG;
}

pub @func is_directory(mode: u32): bool {
    return (mode & S_IFMT) == S_IFDIR;
}

pub @func is_symlink(mode: u32): bool {
    return (mode & S_IFMT) == S_IFLNK;
}

pub @func is_block_device(mode: u32): bool {
    return (mode & S_IFMT) == S_IFBLK;
}

pub @func is_char_device(mode: u32): bool {
    return (mode & S_IFMT) == S_IFCHR;
}

pub @func is_fifo(mode: u32): bool {
    return (mode & S_IFMT) == S_IFIFO;
}

pub @func is_socket(mode: u32): bool {
    return (mode & S_IFMT) == S_IFSOCK;
}

# Constructs a zero-initialized Stat struct in user stack space.
# Required because strict mode expects explicit field initialization.
pub @func init_stat(): Stat {
    $ts0: Timespec = Timespec{ tv_sec: 0, tv_nsec: 0 };
    $pad3: [3]i64 = [0, 0, 0];
    return Stat{
        st_dev: 0,
        st_ino: 0,
        st_nlink: 0,
        st_mode: 0,
        st_uid: 0,
        st_gid: 0,
        __pad0: 0,
        st_rdev: 0,
        st_size: 0,
        st_blksize: 0,
        st_blocks: 0,
        st_atim: ts0,
        st_mtim: ts0,
        st_ctim: ts0,
        __glibc_reserved: pad3,
    };
}

# Constructs a zero-initialized Statfs struct in user stack space.
pub @func init_statfs(): Statfs {
    $fsid: [2]i32 = [0, 0];
    $spare: [4]i64 = [0, 0, 0, 0];
    return Statfs{
        f_type: 0,
        f_bsize: 0,
        f_blocks: 0,
        f_bfree: 0,
        f_bavail: 0,
        f_files: 0,
        f_ffree: 0,
        f_fsid: fsid,
        f_namelen: 0,
        f_frsize: 0,
        f_flags: 0,
        f_spare: spare,
    };
}

# Constructs a zero-initialized Statvfs struct in user stack space.
pub @func init_statvfs(): Statvfs {
    $spare: [5]i32 = [0, 0, 0, 0, 0];
    return Statvfs{
        f_bsize: 0,
        f_frsize: 0,
        f_blocks: 0,
        f_bfree: 0,
        f_bavail: 0,
        f_files: 0,
        f_ffree: 0,
        f_favail: 0,
        f_fsid: 0,
        f_flag: 0,
        f_namemax: 0,
        f_type: 0,
        __f_spare: spare,
    };
}

# Return metadata for the file specified by `path`.
pub @func stat(path: string): Stat | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $st: Stat = init_stat();
    @if (c.stat(buf, &st) != 0) {
        return core.last_error();
    }
    return st;
}

# Return metadata for open file descriptor `fd`.
pub @func fstat(fd: core.Fd): Stat | core.SyscallError {
    $st: Stat = init_stat();
    @if (c.fstat(@as(i32, fd), &st) != 0) {
        return core.last_error();
    }
    return st;
}

# Return metadata for `path`. If `path` is a symbolic link, return metadata for the link itself.
pub @func lstat(path: string): Stat | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $st: Stat = init_stat();
    @if (c.lstat(buf, &st) != 0) {
        return core.last_error();
    }
    return st;
}

# Return metadata relative to directory descriptor `dirfd`.
pub @func fstatat(dirfd: core.Fd, path: string, flags: i32): Stat | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $st: Stat = init_stat();
    @if (c.fstatat(@as(i32, dirfd), buf, &st, flags) != 0) {
        return core.last_error();
    }
    return st;
}

# Return filesystem statistics for the filesystem containing `path`.
pub @func statfs(path: string): Statfs | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $st: Statfs = init_statfs();
    @if (c.statfs(buf, &st) != 0) {
        return core.last_error();
    }
    return st;
}

# Return filesystem statistics for the filesystem referred to by descriptor `fd`.
pub @func fstatfs(fd: core.Fd): Statfs | core.SyscallError {
    $st: Statfs = init_statfs();
    @if (c.fstatfs(@as(i32, fd), &st) != 0) {
        return core.last_error();
    }
    return st;
}

# Return VFS filesystem statistics for the filesystem containing `path`.
pub @func statvfs(path: string): Statvfs | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $st: Statvfs = init_statvfs();
    @if (c.statvfs(buf, &st) != 0) {
        return core.last_error();
    }
    return st;
}

# Return VFS filesystem statistics for descriptor `fd`.
pub @func fstatvfs(fd: core.Fd): Statvfs | core.SyscallError {
    $st: Statvfs = init_statvfs();
    @if (c.fstatvfs(@as(i32, fd), &st) != 0) {
        return core.last_error();
    }
    return st;
}

# Change file permissions of `path` to `mode`.
pub @func chmod(path: string, mode: u32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.chmod(buf, mode) != 0) {
        return core.last_error();
    }
}

# Change permissions of open file descriptor `fd` to `mode`.
pub @func fchmod(fd: core.Fd, mode: u32): void | core.SyscallError {
    @if (c.fchmod(@as(i32, fd), mode) != 0) {
        return core.last_error();
    }
}

# Change permissions relative to directory descriptor `dirfd`.
pub @func fchmodat(dirfd: core.Fd, path: string, mode: u32, flags: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.fchmodat(@as(i32, dirfd), buf, mode, flags) != 0) {
        return core.last_error();
    }
}

# Change owner and group ownership of `path`.
pub @func chown(path: string, owner: core.Uid, group: core.Gid): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.chown(buf, @as(u32, owner), @as(u32, group)) != 0) {
        return core.last_error();
    }
}

# Change owner and group ownership of open descriptor `fd`.
pub @func fchown(fd: core.Fd, owner: core.Uid, group: core.Gid): void | core.SyscallError {
    @if (c.fchown(@as(i32, fd), @as(u32, owner), @as(u32, group)) != 0) {
        return core.last_error();
    }
}

# Change ownership of `path` without dereferencing symbolic links.
pub @func lchown(path: string, owner: core.Uid, group: core.Gid): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.lchown(buf, @as(u32, owner), @as(u32, group)) != 0) {
        return core.last_error();
    }
}

# Change ownership relative to directory descriptor `dirfd`.
pub @func fchownat(dirfd: core.Fd, path: string, owner: core.Uid, group: core.Gid, flags: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.fchownat(@as(i32, dirfd), buf, @as(u32, owner), @as(u32, group), flags) != 0) {
        return core.last_error();
    }
}

# Change file timestamps with nanosecond precision relative to `dirfd`.
# If `atime` or `mtime` is null, that timestamp is omitted (kept unchanged).
pub @func utimensat(dirfd: core.Fd, path: string, atime: ?Timespec, mtime: ?Timespec, flags: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $a_ts: Timespec = Timespec{ tv_sec: 0, tv_nsec: UTIME_OMIT };
    @if (atime != null) {
        a_ts = atime;
    }
    $m_ts: Timespec = Timespec{ tv_sec: 0, tv_nsec: UTIME_OMIT };
    @if (mtime != null) {
        m_ts = mtime;
    }
    $pair: TimePair = TimePair{ atime: a_ts, mtime: m_ts };
    @if (c.utimensat(@as(i32, dirfd), buf, &pair, flags) != 0) {
        return core.last_error();
    }
}

# Change file timestamps of open descriptor `fd`.
# If `atime` or `mtime` is null, that timestamp is omitted (kept unchanged).
pub @func futimens(fd: core.Fd, atime: ?Timespec, mtime: ?Timespec): void | core.SyscallError {
    $a_ts: Timespec = Timespec{ tv_sec: 0, tv_nsec: UTIME_OMIT };
    @if (atime != null) {
        a_ts = atime;
    }
    $m_ts: Timespec = Timespec{ tv_sec: 0, tv_nsec: UTIME_OMIT };
    @if (mtime != null) {
        m_ts = mtime;
    }
    $pair: TimePair = TimePair{ atime: a_ts, mtime: m_ts };
    @if (c.futimens(@as(i32, fd), &pair) != 0) {
        return core.last_error();
    }
}

# Create a filesystem node (special file, FIFO, or regular file) at `path`.
pub @func mknod(path: string, mode: u32, dev: u64): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.mknod(buf, mode, dev) != 0) {
        return core.last_error();
    }
}

# Create a filesystem node relative to directory descriptor `dirfd`.
pub @func mknodat(dirfd: core.Fd, path: string, mode: u32, dev: u64): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.mknodat(@as(i32, dirfd), buf, mode, dev) != 0) {
        return core.last_error();
    }
}

# Create a FIFO special file (named pipe) at `path`.
pub @func mkfifo(path: string, mode: u32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.mkfifo(buf, mode) != 0) {
        return core.last_error();
    }
}

# Create a FIFO special file relative to directory descriptor `dirfd`.
pub @func mkfifoat(dirfd: core.Fd, path: string, mode: u32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.mkfifoat(@as(i32, dirfd), buf, mode) != 0) {
        return core.last_error();
    }
}
