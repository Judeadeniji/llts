# System configuration, priority, scheduling parameters, hardware info, and random bytes.

@const $std = @import("std/core");
@const $c = @import("std/syscall/c");
@const $core = @import("std/syscall/core");

# Priority targets for `getpriority` and `setpriority`.
pub @const $PRIO_PROCESS: i32 = 0;
pub @const $PRIO_PGRP: i32 = 1;
pub @const $PRIO_USER: i32 = 2;

# sysconf constants.
pub @const $SC_ARG_MAX: i32 = 0;
pub @const $SC_CHILD_MAX: i32 = 1;
pub @const $SC_CLK_TCK: i32 = 2;
pub @const $SC_NGROUPS_MAX: i32 = 3;
pub @const $SC_OPEN_MAX: i32 = 4;
pub @const $SC_PAGESIZE: i32 = 30;
pub @const $SC_PAGE_SIZE: i32 = 30;
pub @const $SC_NPROCESSORS_CONF: i32 = 83;
pub @const $SC_NPROCESSORS_ONLN: i32 = 84;
pub @const $SC_PHYS_PAGES: i32 = 85;
pub @const $SC_AVPHYS_PAGES: i32 = 86;

# pathconf constants.
pub @const $PC_LINK_MAX: i32 = 0;
pub @const $PC_MAX_CANON: i32 = 1;
pub @const $PC_MAX_INPUT: i32 = 2;
pub @const $PC_NAME_MAX: i32 = 3;
pub @const $PC_PATH_MAX: i32 = 4;
pub @const $PC_PIPE_BUF: i32 = 5;

# Scheduling policies.
pub @const $SCHED_OTHER: i32 = 0;
pub @const $SCHED_FIFO: i32 = 1;
pub @const $SCHED_RR: i32 = 2;
pub @const $SCHED_BATCH: i32 = 3;
pub @const $SCHED_IDLE: i32 = 5;

# getrandom flags.
pub @const $GRND_NONBLOCK: u32 = 1;
pub @const $GRND_RANDOM: u32 = 2;
pub @const $GRND_INSECURE: u32 = 4;

# Return the current value of a configurable system limit or option.
pub @func sysconf(name: i32): i64 | core.SyscallError {
    $raw = c.sysconf(name);
    @if (raw == -1) {
        return core.last_error();
    }
    return raw;
}

# Return the value of a configurable limit associated with path `path`.
pub @func pathconf(path: string, name: i32): i64 | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $raw = c.pathconf(buf, name);
    @if (raw == -1) {
        return core.last_error();
    }
    return raw;
}

# Return the value of a configurable limit associated with descriptor `fd`.
pub @func fpathconf(fd: core.Fd, name: i32): i64 | core.SyscallError {
    $raw = c.fpathconf(@as(i32, fd), name);
    @if (raw == -1) {
        return core.last_error();
    }
    return raw;
}

# Return the scheduling priority of process, process group, or user `who`.
pub @func getpriority(which: i32, who: i32): i32 | core.SyscallError {
    $err_cell = c.__errno_location();
    err_cell.value = 0;
    $raw = c.getpriority(which, who);
    @if (raw == -1 && err_cell.value != 0) {
        return core.last_error();
    }
    return raw;
}

# Set the scheduling priority of process, process group, or user `who` to `prio`.
pub @func setpriority(which: i32, who: i32, prio: i32): void | core.SyscallError {
    @if (c.setpriority(which, who, prio) != 0) {
        return core.last_error();
    }
}

# Add `inc` to the scheduling priority of the calling process.
pub @func nice(inc: i32): i32 | core.SyscallError {
    $err_cell = c.__errno_location();
    err_cell.value = 0;
    $raw = c.nice(inc);
    @if (raw == -1 && err_cell.value != 0) {
        return core.last_error();
    }
    return raw;
}

# Return the number of processors currently online (available).
pub @func get_nprocs(): i32 {
    return c.get_nprocs();
}

# Return the number of processors configured by the operating system.
pub @func get_nprocs_conf(): i32 {
    return c.get_nprocs_conf();
}

# Return the total number of physical memory pages on the system.
pub @func get_phys_pages(): i64 {
    return c.get_phys_pages();
}

# Return the number of currently available physical memory pages.
pub @func get_avphys_pages(): i64 {
    return c.get_avphys_pages();
}

# Return the 32-bit identifier of the current host.
pub @func gethostid(): i64 {
    return c.gethostid();
}

# Set or inspect the process execution domain (personality).
pub @func personality(persona: u64): i64 | core.SyscallError {
    $raw = c.personality(persona);
    @if (raw == -1) {
        return core.last_error();
    }
    return raw;
}

# Operations on a process: security, thread names, seccomp, etc.
pub @func prctl(option: i32, arg2: u64, arg3: u64, arg4: u64, arg5: u64): i32 | core.SyscallError {
    $raw = c.prctl(option, arg2, arg3, arg4, arg5);
    @if (raw < 0) {
        return core.last_error();
    }
    return raw;
}

# Fill `buf` with cryptographic or high-quality random bytes from the kernel.
pub @func getrandom(buf: []u8, flags: u32): isize | core.SyscallError {
    $count: usize = @as(usize, std.len(buf));
    $raw = c.getrandom(buf, count, flags);
    @if (raw < 0) {
        return core.last_error();
    }
    return @as(isize, raw);
}

# Return the maximum priority value for scheduling algorithm `policy`.
pub @func sched_get_priority_max(policy: i32): i32 | core.SyscallError {
    $raw = c.sched_get_priority_max(policy);
    @if (raw < 0) {
        return core.last_error();
    }
    return raw;
}

# Return the minimum priority value for scheduling algorithm `policy`.
pub @func sched_get_priority_min(policy: i32): i32 | core.SyscallError {
    $raw = c.sched_get_priority_min(policy);
    @if (raw < 0) {
        return core.last_error();
    }
    return raw;
}

# Auxiliary vector types for `getauxval`.
pub @const $AT_NULL: u64 = 0;
pub @const $AT_IGNORE: u64 = 1;
pub @const $AT_EXECFD: u64 = 2;
pub @const $AT_PHDR: u64 = 3;
pub @const $AT_PHENT: u64 = 4;
pub @const $AT_PHNUM: u64 = 5;
pub @const $AT_PAGESZ: u64 = 6;
pub @const $AT_BASE: u64 = 7;
pub @const $AT_FLAGS: u64 = 8;
pub @const $AT_ENTRY: u64 = 9;
pub @const $AT_NOTELF: u64 = 10;
pub @const $AT_UID: u64 = 11;
pub @const $AT_EUID: u64 = 12;
pub @const $AT_GID: u64 = 13;
pub @const $AT_EGID: u64 = 14;
pub @const $AT_CLKTCK: u64 = 17;
pub @const $AT_RANDOM: u64 = 25;
pub @const $AT_EXECFN: u64 = 31;

# Retrieve information from the auxiliary vector.
pub @func getauxval(type: u64): u64 {
    return c.getauxval(type);
}

# Reboot or halt system (privileged: CAP_SYS_BOOT).
pub @func reboot(cmd: i32): void | core.SyscallError {
    @if (c.reboot(cmd) != 0) {
        return core.last_error();
    }
}

# Start swapping to file or block device `path` (privileged: CAP_SYS_ADMIN).
pub @func swapon(path: string, swapflags: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.swapon(buf, swapflags) != 0) {
        return core.last_error();
    }
}

# Stop swapping to file or block device `path` (privileged: CAP_SYS_ADMIN).
pub @func swapoff(path: string): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.swapoff(buf) != 0) {
        return core.last_error();
    }
}

# Read and/or clear kernel message ring buffer (privileged: CAP_SYSLOG).
pub @func klogctl(type: i32): i32 | core.SyscallError {
    $raw = c.klogctl(type, null, 0);
    @if (raw < 0) {
        return core.last_error();
    }
    return raw;
}

# Enable process accounting to `path`, or disable accounting if `path == null` (privileged: CAP_SYS_PACCT).
pub @func acct(path: ?string): void | core.SyscallError {
    @if (path == null) {
        @if (c.acct(null) != 0) {
            return core.last_error();
        }
        return;
    }
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.acct(buf) != 0) {
        return core.last_error();
    }
}

# Resource limit constants defined by POSIX / sys/resource.h
pub @const $RLIMIT_CPU: i32 = 0;
pub @const $RLIMIT_FSIZE: i32 = 1;
pub @const $RLIMIT_DATA: i32 = 2;
pub @const $RLIMIT_STACK: i32 = 3;
pub @const $RLIMIT_CORE: i32 = 4;
pub @const $RLIMIT_RSS: i32 = 5;
pub @const $RLIMIT_NPROC: i32 = 6;
pub @const $RLIMIT_NOFILE: i32 = 7;
pub @const $RLIMIT_MEMLOCK: i32 = 8;
pub @const $RLIMIT_AS: i32 = 9;
pub @const $RLIM_INFINITY: u64 = 18446744073709551615;

# Re-export Rlimit aggregate for resource limits manipulation
pub @alias Rlimit = c.Rlimit;

# Query consumption limit for specified resource `resource`.
pub @func getrlimit(resource: i32): Rlimit | core.SyscallError {
    $r = @zeroed(Rlimit);
    @if (c.getrlimit(resource, &r) != 0) {
        return core.last_error();
    }
    return r;
}

# Set consumption limit for specified resource `resource`.
pub @func setrlimit(resource: i32, rlim: Rlimit): void | core.SyscallError {
    $r: Rlimit = rlim;
    @if (c.setrlimit(resource, &r) != 0) {
        return core.last_error();
    }
}

# Query and optionally set resource limits of process `pid` (or calling process if `pid == 0`).
pub @func prlimit(pid: core.Pid, resource: i32, new_limit: ?*Rlimit): Rlimit | core.SyscallError {
    $old = @zeroed(Rlimit);
    @if (c.prlimit(@as(i32, pid), resource, new_limit, &old) != 0) {
        return core.last_error();
    }
    return old;
}

@func c_slice_to_string(buf: []u8): string {
    $len: usize = 0;
    @for (buf) |b| {
        @if (b == 0) { break; }
        len += 1;
    }
    return @as(string, buf[0..len]);
}

# High-level system information returned by `uname`.
pub @struct UtsInfo {
    sysname: string;
    nodename: string;
    release: string;
    version: string;
    machine: string;
    domainname: string;
}

pub @alias Utsname = c.Utsname;
pub @alias Sysinfo = c.Sysinfo;
pub @alias RUsage = c.RUsage;
pub @const $RUSAGE_SELF: i32 = c.RUSAGE_SELF;
pub @const $RUSAGE_CHILDREN: i32 = c.RUSAGE_CHILDREN;

# Query identification and information about the current operating system and hardware.
pub @func uname(): UtsInfo | core.SyscallError {
    $raw = @zeroed(Utsname);
    @if (c.uname(&raw) != 0) {
        return core.last_error();
    }
    return UtsInfo{
        sysname: c_slice_to_string(raw.sysname[0..65]),
        nodename: c_slice_to_string(raw.nodename[0..65]),
        release: c_slice_to_string(raw.release[0..65]),
        version: c_slice_to_string(raw.version[0..65]),
        machine: c_slice_to_string(raw.machine[0..65]),
        domainname: c_slice_to_string(raw.domainname[0..65]),
    };
}

# Return the standard host name for the current machine.
pub @func gethostname(): string | core.SyscallError {
    $buf: [256]u8 = @zeroed([256]u8);
    @if (c.gethostname(&buf[0], 256) != 0) {
        return core.last_error();
    }
    return c_slice_to_string(buf[0..256]);
}

# Set the host name of the current machine (requires privileged capabilities).
pub @func sethostname(name: string): void | core.SyscallError {
    $c_name = @as(c_str, name);
    @if (c.sethostname(c_name, @as(usize, name.len)) != 0) {
        return core.last_error();
    }
}

# Return the NIS/YP domain name for the current machine.
pub @func getdomainname(): string | core.SyscallError {
    $buf: [256]u8 = @zeroed([256]u8);
    @if (c.getdomainname(&buf[0], 256) != 0) {
        return core.last_error();
    }
    return c_slice_to_string(buf[0..256]);
}

# Set the NIS/YP domain name for the current machine (requires privileged capabilities).
pub @func setdomainname(name: string): void | core.SyscallError {
    $c_name = @as(c_str, name);
    @if (c.setdomainname(c_name, @as(usize, name.len)) != 0) {
        return core.last_error();
    }
}

# Return system-wide memory, load average, and process statistics.
pub @func sysinfo(): Sysinfo | core.SyscallError {
    $info = @zeroed(Sysinfo);
    @if (c.sysinfo(&info) != 0) {
        return core.last_error();
    }
    return info;
}

# Return resource usage measures for `who` (`RUSAGE_SELF` or `RUSAGE_CHILDREN`).
pub @func getrusage(who: i32): RUsage | core.SyscallError {
    $usage = @zeroed(RUsage);
    @if (c.getrusage(who, &usage) != 0) {
        return core.last_error();
    }
    return usage;
}
