# Raw C ABI extern declarations (internal to syscall library).
# Do not import directly outside this library; use `std/syscall` wrappers.
#
# Signatures below were checked against the platform C headers:
#   int     close(int fd);
#   ssize_t read(int fd, void *buf, size_t count);
#   ssize_t write(int fd, const void *buf, size_t count);
#   off_t   lseek(int fd, off_t offset, int whence);
#   int     ftruncate(int fd, off_t length);
#   int     open(const char *path, int flags, ... /* mode_t mode */);
#   int     unlink(const char *path);
#   int     isatty(int fd);
#   pid_t   getpid(void);
#   void   *malloc(size_t size);
#   void    free(void *ptr);
#   int    *__errno_location(void);
#   void    exit(int status) __attribute__((noreturn));
#   void    abort(void) __attribute__((noreturn));
#
# On the supported LP64 targets: size_t = ssize_t = off_t = 64 bits (usize /
# isize / i64 below), pid_t = mode_t = 32 bits. C `void *`/`const void *`
# parameters are spelled with byte pointers because LLTS has no `void` pointer;
# they are ABI-identical. `open`'s variadic `mode_t` is passed as an `i32`
# (same 32-bit slot; the wrappers only pass permission bits).

# Pointer-sized scratch type for NUL-terminated paths. C sees a `char *`; LLTS
# sees a struct so the wrappers can index bytes without exposing `c_str`.
pub @const $PATH_CAPACITY: usize = 4096;

pub @struct CBuffer {
    bytes: [4096]u8;
}

# `errno` lives behind a per-thread pointer; a one-field struct lets the
# wrappers read it without making `*i32` part of the language surface.
pub @struct ErrnoCell {
    value: i32;
}

pub @struct PipeFds {
    read_fd: i32;
    write_fd: i32;
}

pub @struct WaitStatus {
    value: i32;
}

pub @struct ClockIdCell {
    value: i32;
}

pub @struct EventfdValue {
    value: u64;
}

pub @struct IdCell {
    value: u32;
}

pub @extern "c" @func exit(status: i32): never;
pub @extern "c" @func abort(): never;

pub @extern "c" @func read(fd: i32, buf: *u8, count: usize): isize;
pub @extern "c" @func write(fd: i32, buf: *u8, count: usize): isize;
pub @extern "c" @func pread(fd: i32, buf: *u8, count: usize, offset: i64): isize;
pub @extern "c" @func pwrite(fd: i32, buf: *u8, count: usize, offset: i64): isize;
pub @extern "c" @func close(fd: i32): i32;
pub @extern "c" @func lseek(fd: i32, offset: i64, whence: i32): i64;
pub @extern "c" @func ftruncate(fd: i32, length: i64): i32;
pub @extern "c" @func truncate(path: *CBuffer, length: i64): i32;

pub @extern "c" @func fsync(fd: i32): i32;
pub @extern "c" @func fdatasync(fd: i32): i32;
pub @extern "c" @func sync(): void;
pub @extern "c" @func syncfs(fd: i32): i32;

pub @extern "c" @func dup(oldfd: i32): i32;
pub @extern "c" @func dup2(oldfd: i32, newfd: i32): i32;
pub @extern "c" @func dup3(oldfd: i32, newfd: i32, flags: i32): i32;

pub @extern "c" @func pipe(pipefd: *PipeFds): i32;
pub @extern "c" @func pipe2(pipefd: *PipeFds, flags: i32): i32;

pub @extern "c" @func posix_fadvise(fd: i32, offset: i64, len: i64, advice: i32): i32;
pub @extern "c" @func posix_fallocate(fd: i32, offset: i64, len: i64): i32;
pub @extern "c" @func fallocate(fd: i32, mode: i32, offset: i64, len: i64): i32;

pub @extern "c" @func close_range(first: u32, last: u32, flags: u32): i32;
pub @extern "c" @func closefrom(lowfd: i32): void;

pub @extern "c" @func fcntl(fd: i32, cmd: i32, arg: i64): i64;
pub @extern "c" @func getdtablesize(): i32;

pub @extern "c" @func sendfile(out_fd: i32, in_fd: i32, offset: ?*i64, count: usize): isize;
pub @extern "c" @func copy_file_range(fd_in: i32, off_in: ?*i64, fd_out: i32, off_out: ?*i64, len: usize, flags: u32): isize;

pub @const $AT_FDCWD: i32 = -100;
pub @const $AT_SYMLINK_NOFOLLOW: i32 = 256;
pub @const $AT_REMOVEDIR: i32 = 512;
pub @const $AT_EACCESS: i32 = 512;

pub @extern "c" @func open(path: *CBuffer, flags: i32, mode: i32): i32;
