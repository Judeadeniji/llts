# Raw C ABI extern declarations (internal to syscall library).
# Do not import directly outside this library; use `std/syscall` wrappers.
#
# Signatures below were checked against the platform C headers:
#   int     close(int fd);
#   ssize_t read(int fd, void *buf, size_t count);
#   ssize_t write(int fd, const void *buf, size_t count);
#   off_t   lseek(int fd, off_t offset, int whence);
#   int     ftruncate(int fd, off_t length);
#   int     open(const char *path, int flags, ... /* mode_t mode */);
#   int     unlink(const char *path);
#   int     isatty(int fd);
#   pid_t   getpid(void);
#   void   *malloc(size_t size);
#   void    free(void *ptr);
#   int    *__errno_location(void);
#   void    exit(int status) __attribute__((noreturn));
#   void    abort(void) __attribute__((noreturn));
#
# On the supported LP64 targets: size_t = ssize_t = off_t = 64 bits (usize /
# isize / i64 below), pid_t = mode_t = 32 bits. C `void *`/`const void *`
# parameters are spelled with byte pointers because LLTS has no `void` pointer;
# they are ABI-identical. `open`'s variadic `mode_t` is passed as an `i32`
# (same 32-bit slot; the wrappers only pass permission bits).

# Pointer-sized scratch type for NUL-terminated paths. C sees a `char *`; LLTS
# sees a struct so the wrappers can index bytes without exposing `c_str`.
pub @const $PATH_CAPACITY: usize = 4096;

pub @struct CBuffer {
    bytes: [4096]u8;
}

# `errno` lives behind a per-thread pointer; a one-field struct lets the
# wrappers read it without making `*i32` part of the language surface.
pub @struct ErrnoCell {
    value: i32;
}

pub @struct PipeFds {
    read_fd: i32;
    write_fd: i32;
}

pub @struct WaitStatus {
    value: i32;
}

pub @struct ClockIdCell {
    value: i32;
}

pub @struct EventfdValue {
    value: u64;
}

pub @struct IdCell {
    value: u32;
}

# POSIX timespec aggregate (tv_sec: seconds, tv_nsec: nanoseconds).
# Used by high-resolution timestamp queries, sleeps, and file touch operations.
pub @extern "c" @struct Timespec {
    tv_sec: i64;
    tv_nsec: i64;
}

# Two consecutive Timespec values as expected by utimensat() and futimens().
pub @extern "c" @struct TimePair {
    atime: Timespec;
    mtime: Timespec;
}

# Linux x86-64 C ABI struct stat (144 bytes, 8-byte aligned).
# Memory layout strictly matches glibc bits/struct_stat.h on LP64 architectures.
pub @extern "c" @struct Stat {
    st_dev: u64;
    st_ino: u64;
    st_nlink: u64;
    st_mode: u32;
    st_uid: u32;
    st_gid: u32;
    __pad0: i32;
    st_rdev: u64;
    st_size: i64;
    st_blksize: i64;
    st_blocks: i64;
    st_atim: Timespec;
    st_mtim: Timespec;
    st_ctim: Timespec;
    __glibc_reserved: [3]i64;
}

# Linux x86-64 C ABI struct statfs (120 bytes, 8-byte aligned).
# Returned by statfs() and fstatfs() for filesystem-wide statistics.
pub @extern "c" @struct Statfs {
    f_type: i64;
    f_bsize: i64;
    f_blocks: u64;
    f_bfree: u64;
    f_bavail: u64;
    f_files: u64;
    f_ffree: u64;
    f_fsid: [2]i32;
    f_namelen: i64;
    f_frsize: i64;
    f_flags: i64;
    f_spare: [4]i64;
}

# POSIX / Linux x86-64 C ABI struct statvfs (112 bytes, 8-byte aligned).
# Returned by statvfs() and fstatvfs() for VFS filesystem statistics.
pub @extern "c" @struct Statvfs {
    f_bsize: u64;
    f_frsize: u64;
    f_blocks: u64;
    f_bfree: u64;
    f_bavail: u64;
    f_files: u64;
    f_ffree: u64;
    f_favail: u64;
    f_fsid: u64;
    f_flag: u64;
    f_namemax: u64;
    f_type: u32;
    __f_spare: [5]i32;
}

# POSIX pollfd aggregate for poll() / ppoll() multiplexing.
pub @extern "c" @struct Pollfd {
    fd: i32;
    events: i16;
    revents: i16;
}

# POSIX iovec aggregate for scatter/gather (vectored) I/O operations.
pub @extern "c" @struct Iovec {
    iov_base: *u8;
    iov_len: usize;
}

# POSIX rlimit aggregate for getrlimit() / setrlimit() resource limits.
pub @extern "c" @struct Rlimit {
    rlim_cur: u64;
    rlim_max: u64;
}

# Linux x86-64 C ABI struct termios (60 bytes, 4-byte aligned).
# Terminal control settings passed to tcgetattr() and tcsetattr().
pub @extern "c" @struct Termios {
    c_iflag: u32;
    c_oflag: u32;
    c_cflag: u32;
    c_lflag: u32;
    c_line: u8;
    c_cc: [32]u8;
    __pad: [3]u8;
    c_ispeed: u32;
    c_ospeed: u32;
}

# IPv4 socket address aggregate (16 bytes, align 4/2 matching struct sockaddr_in).
pub @extern "c" @struct SockaddrIn {
    sin_family: u16;
    sin_port: u16;
    sin_addr: u32;
    sin_zero: [8]u8;
}

# Generic socket address aggregate (16 bytes, align 2 matching struct sockaddr).
pub @extern "c" @struct Sockaddr {
    sa_family: u16;
    sa_data: [14]u8;
}

