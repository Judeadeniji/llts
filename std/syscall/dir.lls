# Directory operations, links, and filesystem navigation.

@const $c = @import("std/syscall/c");
@const $core = @import("std/syscall/core");
@const $std = @import("std/core");

pub @const $PATH_CAPACITY: usize = c.PATH_CAPACITY;
pub @const $DEFAULT_DIR_MODE: i32 = 0o755;

pub @const $AT_FDCWD: core.Fd = @as(core.Fd, c.AT_FDCWD);
pub @const $AT_SYMLINK_NOFOLLOW: i32 = c.AT_SYMLINK_NOFOLLOW;
pub @const $AT_REMOVEDIR: i32 = c.AT_REMOVEDIR;
pub @const $AT_EACCESS: i32 = c.AT_EACCESS;

# Accessibility check modes for `access` and `faccessat`.
pub @enum AccessMode {
    Exists = 0,
    Execute = 1,
    Write = 2,
    Read = 4,
}

pub @func access_bits(modes: []AccessMode): i32 {
    $bits: i32 = 0;
    @for (modes) |m| {
        bits = bits | @as(i32, m);
    }
    return bits;
}

# Create a new directory named `path` with permission bits `mode`.
pub @func mkdir(path: string, mode: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.mkdir(buf, mode) != 0) {
        return core.last_error();
    }
}

# Create a new directory relative to directory file descriptor `dirfd`.
pub @func mkdirat(dirfd: core.Fd, path: string, mode: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.mkdirat(@as(i32, dirfd), buf, mode) != 0) {
        return core.last_error();
    }
}

# Remove an empty directory named `path`.
pub @func rmdir(path: string): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.rmdir(buf) != 0) {
        return core.last_error();
    }
}

# Delete a name from the filesystem.
pub @func unlink(path: string): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.unlink(buf) != 0) {
        return core.last_error();
    }
}

# Delete a name relative to directory file descriptor `dirfd`. Pass `AT_REMOVEDIR`
# in `flags` to remove a directory.
pub @func unlinkat(dirfd: core.Fd, path: string, flags: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.unlinkat(@as(i32, dirfd), buf, flags) != 0) {
        return core.last_error();
    }
}

# Create a hard link `newpath` pointing to existing file `oldpath`.
pub @func link(oldpath: string, newpath: string): void | core.SyscallError {
    $b_old = core.path_buffer(oldpath)?;
    defer c.free(b_old);
    $b_new = core.path_buffer(newpath)?;
    defer c.free(b_new);
    @if (c.link(b_old, b_new) != 0) {
        return core.last_error();
    }
}

# Create a hard link relative to directory file descriptors.
pub @func linkat(olddirfd: core.Fd, oldpath: string, newdirfd: core.Fd, newpath: string, flags: i32): void | core.SyscallError {
    $b_old = core.path_buffer(oldpath)?;
    defer c.free(b_old);
    $b_new = core.path_buffer(newpath)?;
    defer c.free(b_new);
    @if (c.linkat(@as(i32, olddirfd), b_old, @as(i32, newdirfd), b_new, flags) != 0) {
        return core.last_error();
    }
}

# Create a symbolic link `linkpath` pointing to `target`.
pub @func symlink(target: string, linkpath: string): void | core.SyscallError {
    $b_target = core.path_buffer(target)?;
    defer c.free(b_target);
    $b_link = core.path_buffer(linkpath)?;
    defer c.free(b_link);
    @if (c.symlink(b_target, b_link) != 0) {
        return core.last_error();
    }
}

# Create a symbolic link relative to directory file descriptor `newdirfd`.
pub @func symlinkat(target: string, newdirfd: core.Fd, linkpath: string): void | core.SyscallError {
    $b_target = core.path_buffer(target)?;
    defer c.free(b_target);
    $b_link = core.path_buffer(linkpath)?;
    defer c.free(b_link);
    @if (c.symlinkat(b_target, @as(i32, newdirfd), b_link) != 0) {
        return core.last_error();
    }
}

# Rename a file or directory from `oldpath` to `newpath`.
pub @func rename(oldpath: string, newpath: string): void | core.SyscallError {
    $b_old = core.path_buffer(oldpath)?;
    defer c.free(b_old);
    $b_new = core.path_buffer(newpath)?;
    defer c.free(b_new);
    @if (c.rename(b_old, b_new) != 0) {
        return core.last_error();
    }
}

# Rename a file or directory relative to directory file descriptors.
pub @func renameat(olddirfd: core.Fd, oldpath: string, newdirfd: core.Fd, newpath: string): void | core.SyscallError {
    $b_old = core.path_buffer(oldpath)?;
    defer c.free(b_old);
    $b_new = core.path_buffer(newpath)?;
    defer c.free(b_new);
    @if (c.renameat(@as(i32, olddirfd), b_old, @as(i32, newdirfd), b_new) != 0) {
        return core.last_error();
    }
}

# Change the current working directory to `path`.
pub @func chdir(path: string): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.chdir(buf) != 0) {
        return core.last_error();
    }
}

# Change the current working directory to open directory `fd`.
pub @func fchdir(fd: core.Fd): void | core.SyscallError {
    @if (c.fchdir(@as(i32, fd)) != 0) {
        return core.last_error();
    }
}

# Change the root directory of the calling process to `path`.
pub @func chroot(path: string): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.chroot(buf) != 0) {
        return core.last_error();
    }
}

# Check user's permissions for the file at `path`.
pub @func access(path: string, mode: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.access(buf, mode) != 0) {
        return core.last_error();
    }
}

# Check accessibility of `path` relative to directory descriptor `dirfd`.
pub @func faccessat(dirfd: core.Fd, path: string, mode: i32, flags: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.faccessat(@as(i32, dirfd), buf, mode, flags) != 0) {
        return core.last_error();
    }
}

# Check effective user permissions for the file at `path`.
pub @func eaccess(path: string, mode: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.eaccess(buf, mode) != 0) {
        return core.last_error();
    }
}

# Check effective user permissions (alias for `eaccess`).
pub @func euidaccess(path: string, mode: i32): void | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    @if (c.euidaccess(buf, mode) != 0) {
        return core.last_error();
    }
}

# Re-exported directory handle and entry types.
pub @alias Directory = c.Directory;
pub @alias Dirent = c.Dirent;

# `d_type` values reported by `readdir`.
pub @const $DT_UNKNOWN: u8 = 0;
pub @const $DT_FIFO: u8 = 1;
pub @const $DT_CHR: u8 = 2;
pub @const $DT_DIR: u8 = 4;
pub @const $DT_BLK: u8 = 6;
pub @const $DT_REG: u8 = 8;
pub @const $DT_LNK: u8 = 10;
pub @const $DT_SOCK: u8 = 12;

# Open the directory at `path` for iteration.
pub @func opendir(path: string): *Directory | core.SyscallError {
    $buf = core.path_buffer(path)?;
    defer c.free(buf);
    $raw = c.opendir(buf);
    @if (raw == null) {
        return core.last_error();
    }
    return raw.?;
}

# Wrap the directory file descriptor `fd` in a directory stream. `fd` must
# refer to a directory and must not be used independently afterwards.
pub @func fdopendir(fd: core.Fd): *Directory | core.SyscallError {
    $raw = c.fdopendir(@as(i32, fd));
    @if (raw == null) {
        return core.last_error();
    }
    return raw.?;
}

# Return the next directory entry, or `null` at end of stream. The returned
# pointer is owned by the directory stream and is invalidated by the next call.
pub @func readdir(dir: *Directory): ?*Dirent | core.SyscallError {
    $errno = c.__errno_location();
    errno.value = 0;
    $entry = c.readdir(dir);
    @if (entry == null) {
        @if (errno.value != 0) {
            return core.last_error();
        }
        return null;
    }
    return entry;
}

# Close a directory stream.
pub @func closedir(dir: *Directory): void | core.SyscallError {
    @if (c.closedir(dir) != 0) {
        return core.last_error();
    }
}

# Reset a directory stream to its beginning.
pub @func rewinddir(dir: *Directory): void {
    c.rewinddir(dir);
}

# Seek a directory stream to a position returned by `telldir`.
pub @func seekdir(dir: *Directory, location: i64): void {
    c.seekdir(dir, location);
}

# Return the current position of a directory stream.
pub @func telldir(dir: *Directory): i64 {
    return c.telldir(dir);
}

# Return the file descriptor underlying a directory stream.
pub @func dirfd(dir: *Directory): core.Fd | core.SyscallError {
    $raw = c.dirfd(dir);
    @if (raw < 0) {
        return core.last_error();
    }
    return @as(core.Fd, raw);
}

# Copy the NUL-terminated `d_name` of `entry` into an LLTS string slice. The
# slice borrows the directory stream's storage until the next `readdir`.
pub @func dirent_name(entry: *Dirent): string {
    $n: i64 = 0;
    @for (0..256) |i| {
        @if (entry.d_name[i] == 0) {
            break;
        }
        n = n + 1;
    }
    return entry.d_name[0..n];
}

# Read raw directory entries through `getdirentries` (the glibc wrapper over
# `getdents64`) into `buffer`. Returns the number of bytes written.
pub @func getdirentries(fd: core.Fd, buffer: []u8): usize | core.SyscallError {
    $len: usize = @as(usize, std.len(buffer));
    @if (len == 0) {
        return core.SyscallError.InvalidArgument;
    }
    $base = c.OffCell{ value: 0 };
    $n = c.getdirentries(@as(i32, fd), &buffer[0], len, &base);
    @if (n < 0) {
        return core.last_error();
    }
    return @as(usize, n);
}

# Set the calling process's file mode creation mask to `mask` & 0777.
# Returns the previous value of the mask.
pub @func umask(mask: u32): u32 {
    return c.umask(mask);
}

# Return the current file mode creation mask without modifying it.
pub @func getumask(): u32 {
    $mask = c.umask(0);
    _ = c.umask(mask);
    return mask;
}

# Return the current working directory as an LLTS string.
# Returns an error if the path exceeds PATH_CAPACITY (4096 bytes) or on permission error.
pub @func getcwd(): string | core.SyscallError {
    $buf: [4096]u8 = @zeroed([4096]u8);
    $res = c.getcwd(&buf[0], 4096);
    @if (res == null) {
        return core.last_error();
    }
    return @as(string, res.?);
}

# Alias for `getcwd` conforming to GNU naming.
pub @func get_current_dir_name(): string | core.SyscallError {
    return getcwd();
}

# Resolve all symbolic links, extra `/`, and `.` or `..` components in `path`.
# Produces a canonical absolute path.
pub @func realpath(path: string): string | core.SyscallError {
    $c_path = @as(c_str, path);
    $buf: [4096]u8 = @zeroed([4096]u8);
    $res = c.realpath(c_path, &buf[0]);
    @if (res == null) {
        return core.last_error();
    }
    return @as(string, res.?);
}
