# Time retrieval and CPU clock IDs.

@const $c = @import("std/syscall/c");
@const $core = @import("std/syscall/core");

# Return the current time as seconds since the Epoch (1970-01-01 00:00:00 UTC).
pub @func time(): i64 | core.SyscallError {
    $raw = c.time(null);
    @if (raw == -1) {
        return core.last_error();
    }
    return raw;
}

# Return the clock ID of the CPU-time clock of the process `pid` (or calling process if `pid == 0`).
pub @func clock_getcpuclockid(pid: core.Pid): i32 | core.SyscallError {
    $cell = c.ClockIdCell{ value: 0 };
    @if (c.clock_getcpuclockid(@as(i32, pid), &cell) != 0) {
        return core.last_error();
    }
    return cell.value;
}
