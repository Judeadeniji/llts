# I/O multiplexing and readiness polling.
#
# Provides safe LLTS wrappers over POSIX poll() and ppoll() calls using Pollfd descriptors.

@const $c = @import("std/syscall/c");
@const $core = @import("std/syscall/core");
@const $std = @import("std/core");

# Re-export Pollfd and Timespec aggregates.
pub @alias Pollfd = c.Pollfd;
pub @alias Timespec = c.Timespec;
pub @alias CEpollEvent = c.CEpollEvent;

# Event condition bitmasks matching poll.h
pub @const $POLLIN: i16 = 1;        # There is data to read
pub @const $POLLPRI: i16 = 2;       # There is urgent data to read
pub @const $POLLOUT: i16 = 4;       # Writing now will not block
pub @const $POLLERR: i16 = 8;       # Error condition (always reported in revents)
pub @const $POLLHUP: i16 = 16;      # Hung up (always reported in revents)
pub @const $POLLNVAL: i16 = 32;     # Invalid request: fd not open (always reported in revents)

# Constructs a zero-initialized Pollfd descriptor for descriptor `fd` and requested `events`.
pub @func init_pollfd(fd: core.Fd, events: i16): Pollfd {
    return Pollfd{
        fd: @as(i32, fd),
        events: events,
        revents: 0,
    };
}

# Poll a single file descriptor `fd` for requested `events` with millisecond `timeout`.
# Returns the returned events mask (`revents`), or 0 on timeout.
pub @func poll_one(fd: core.Fd, events: i16, timeout: i32): i16 | core.SyscallError {
    $pfd: Pollfd = init_pollfd(fd, events);
    $rc = c.poll(&pfd, 1, timeout);
    @if (rc < 0) {
        return core.last_error();
    }
    return pfd.revents;
}

# Wait for events on a slice of `Pollfd` descriptors.
# Returns the number of descriptors with non-zero `revents`, or 0 on timeout.
pub @func poll(fds: []Pollfd, timeout: i32): i32 | core.SyscallError {
    $n: u64 = @as(u64, std.len(fds));
    @if (n == 0) {
        $pfd: Pollfd = init_pollfd(@as(core.Fd, -1), 0);
        $rc = c.poll(&pfd, 0, timeout);
        @if (rc < 0) {
            return core.last_error();
        }
        return rc;
    }
    $rc = c.poll(&fds[0], n, timeout);
    @if (rc < 0) {
        return core.last_error();
    }
    return rc;
}

# Epoll event condition masks and operations
pub @const $EPOLL_CTL_ADD: i32 = c.EPOLL_CTL_ADD;
pub @const $EPOLL_CTL_DEL: i32 = c.EPOLL_CTL_DEL;
pub @const $EPOLL_CTL_MOD: i32 = c.EPOLL_CTL_MOD;
pub @const $EPOLLIN: u32 = c.EPOLLIN;
pub @const $EPOLLOUT: u32 = c.EPOLLOUT;
pub @const $EPOLLERR: u32 = c.EPOLLERR;
pub @const $EPOLLHUP: u32 = c.EPOLLHUP;

pub @enum EpollOp {
    Add = 1,
    Del = 2,
    Mod = 3,
}

# Safe user-facing representation of epoll events with 64-bit user data.
pub @struct EpollEvent {
    events: u32;
    data: u64;
}

# Open an epoll file descriptor. Flags can be 0 or EPOLL_CLOEXEC (0o2000000).
pub @func epoll_create1(flags: i32): core.Fd | core.SyscallError {
    $fd = c.epoll_create1(flags);
    @if (fd < 0) {
        return core.last_error();
    }
    return @as(core.Fd, fd);
}

# Control interface for an epoll file descriptor: register, modify, or remove interest in target fd.
pub @func epoll_ctl(epfd: core.Fd, op: EpollOp, target_fd: core.Fd, event: ?EpollEvent): void | core.SyscallError {
    $ev_ptr: ?*CEpollEvent = null;
    $raw_ev = @zeroed(CEpollEvent);
    @if (event != null) {
        $ev = event;
        raw_ev.events = ev.events;
        raw_ev.data_low = @as(u32, ev.data & 0xFFFFFFFF);
        raw_ev.data_high = @as(u32, (ev.data >> 32) & 0xFFFFFFFF);
        ev_ptr = &raw_ev;
    }
    @if (c.epoll_ctl(@as(i32, epfd), @as(i32, op), @as(i32, target_fd), ev_ptr) != 0) {
        return core.last_error();
    }
}

# Wait for I/O events on an epoll file descriptor. Returns number of ready events received.
pub @func epoll_wait(epfd: core.Fd, events: []EpollEvent, timeout_ms: i32): i32 | core.SyscallError {
    $n = events.len;
    @if (n == 0) {
        return 0;
    }
    $raw_events: [64]CEpollEvent = @zeroed([64]CEpollEvent);
    $cap = n;
    @if (cap > 64) {
        cap = 64;
    }
    $ready = c.epoll_wait(@as(i32, epfd), &raw_events[0], @as(i32, cap), timeout_ms);
    @if (ready < 0) {
        return core.last_error();
    }
    $i: usize = 0;
    @for (i < @as(usize, ready)) {
        $raw = raw_events[i];
        events[i] = EpollEvent{
            events: raw.events,
            data: @as(u64, raw.data_low) | (@as(u64, raw.data_high) << 32),
        };
        i += 1;
    }
    return ready;
}
