pub @func printLn(msg, a, b, c, d) {
    __printLn(msg, a, b, c, d);
}

pub @func log(msg) {
    info(msg);
}

pub @func trace(msg) {
    __hostLog("trace", msg);
}

pub @func debug(msg) {
    __hostLog("debug", msg);
}

pub @func info(msg) {
    __hostLog("info", msg);
}

pub @func warn(msg) {
    __hostLog("warn", msg);
}

pub @func err(msg) {
    # Auto-detects LLTS error values: logs code (+ payload) without a redundant
    # "Error:" prefix under the ERROR level.
    __hostLog("error", msg);
}

pub @func assert(condition) {
    @if (condition) {
        return null;
    } @else {
        return error("AssertFailed", condition);
    }
}
