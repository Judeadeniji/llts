# Arena-backed map (string keys). Reclaimed with `arena.reset()` / `deinit()`.

@const $mem = @import("std/mem.lls");

pub @func create(arena: mem.Arena) {
    return __mapCreate(arena);
}

pub @func set(mp, key, value) {
    return __mapSet(mp, key, value);
}

pub @func get(mp, key) {
    return __mapGet(mp, key);
}

pub @func has(mp, key) {
    return __mapHas(mp, key);
}

pub @func delete(mp, key) {
    return __mapDelete(mp, key);
}

pub @func size(mp) {
    return __mapSize(mp);
}
