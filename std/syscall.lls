# Syscall library: LLTS wrappers over platform C ABI primitives.
#
# The API is grouped by area; this module re-exports every group so one import
# reaches all of it:
#
#   @const $sys = @import("std/syscall");
#   $file = sys.io.open_write(path)?;
#   sys.io.write_all(file, "hi")?;
#
# `sys.core` holds the shared types (`Fd`, `Pid`, `SyscallError`, …), `sys.io`
# covers descriptors and paths, and `sys.process` covers process identity and
# termination. Raw extern declarations live in `std/syscall/c`; do not import
# that module directly.

pub @const $core = @import("std/syscall/core");
pub @const $io = @import("std/syscall/io");
pub @const $stat = @import("std/syscall/stat");
pub @const $dir = @import("std/syscall/dir");
pub @const $process = @import("std/syscall/process");
pub @const $signal = @import("std/syscall/signal");
pub @const $time = @import("std/syscall/time");
pub @const $memory = @import("std/syscall/memory");
pub @const $event = @import("std/syscall/event");
pub @const $poll = @import("std/syscall/poll");
pub @const $term = @import("std/syscall/term");
pub @const $system = @import("std/syscall/system");
pub @const $ipc = @import("std/syscall/ipc");
pub @const $socket = @import("std/syscall/socket");

@const $c = @import("std/syscall/c");

# Re-exported primary types for callers using the top-level facade.

# Descriptors, identifiers, exit codes, and error set.
pub @alias Fd = core.Fd;
pub @alias Pid = core.Pid;
pub @alias Uid = core.Uid;
pub @alias Gid = core.Gid;
pub @alias Stdio = core.Stdio;
pub @alias ExitCode = core.ExitCode;
pub @alias SyscallError = core.SyscallError;

# File I/O access, flags, permissions, and seek origin
pub @alias Access = io.Access;
pub @alias OpenFlag = io.OpenFlag;
pub @alias Permission = io.Permission;
pub @alias SeekWhence = io.SeekWhence;
pub @alias Iovec = io.Iovec;

# Directory access check modes
pub @alias AccessMode = dir.AccessMode;

# File metadata, filesystem statistics, and timestamps
pub @alias Timespec = stat.Timespec;
pub @alias Stat = stat.Stat;
pub @alias Statfs = stat.Statfs;
pub @alias Statvfs = stat.Statvfs;

# I/O event multiplexing
pub @alias Pollfd = poll.Pollfd;

# Terminal control settings
pub @alias Termios = term.Termios;

# Resource consumption limits
pub @alias Rlimit = system.Rlimit;

# Network socket addresses and connection states
pub @alias SockaddrIn = socket.SockaddrIn;
pub @alias Sockaddr = socket.Sockaddr;
pub @alias AcceptedSocket = socket.AcceptedSocket;

# System and resource information
pub @alias UtsInfo = system.UtsInfo;
pub @alias Sysinfo = system.Sysinfo;
pub @alias RUsage = system.RUsage;

# Epoll event polling
pub @alias EpollEvent = poll.EpollEvent;
pub @alias EpollOp = poll.EpollOp;

# C string and LLTS string conversions
pub @const $from_c_str = core.from_c_str;
pub @const $to_c_str = core.to_c_str;
pub @const $opt_from_c_str = core.opt_from_c_str;
pub @const $opt_to_c_str = core.opt_to_c_str;


# Raw Linux syscall escape hatch


# A nominal Linux x86-64 syscall number. Constants are provided for the entry
# points this library does not wrap; construct one directly for anything else.
pub @struct SyscallNumber {
    value: i64;
}

