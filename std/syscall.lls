# Invoke a raw Linux syscall with all six argument registers.
pub @func syscall(number: SyscallNumber, a1: isize, a2: isize, a3: isize, a4: isize, a5: isize, a6: isize): isize | core.SyscallError {
    $raw = c.syscall(number.value, a1, a2, a3, a4, a5, a6);
    @if (raw < 0) {
        return core.last_error();
    }
    return @as(isize, raw);
}

# Arity helpers for the common cases.
pub @func syscall0(number: SyscallNumber): isize | core.SyscallError {
    return syscall(number, 0, 0, 0, 0, 0, 0);
}

pub @func syscall1(number: SyscallNumber, a1: isize): isize | core.SyscallError {
    return syscall(number, a1, 0, 0, 0, 0, 0);
}

pub @func syscall2(number: SyscallNumber, a1: isize, a2: isize): isize | core.SyscallError {
    return syscall(number, a1, a2, 0, 0, 0, 0);
}

pub @func syscall3(number: SyscallNumber, a1: isize, a2: isize, a3: isize): isize | core.SyscallError {
    return syscall(number, a1, a2, a3, 0, 0, 0);
}

pub @func syscall4(number: SyscallNumber, a1: isize, a2: isize, a3: isize, a4: isize): isize | core.SyscallError {
    return syscall(number, a1, a2, a3, a4, 0, 0);
}

pub @func syscall5(number: SyscallNumber, a1: isize, a2: isize, a3: isize, a4: isize, a5: isize): isize | core.SyscallError {
    return syscall(number, a1, a2, a3, a4, a5, 0);
}

