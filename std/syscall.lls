# Low-level OS syscalls — Linux-oriented, Zig/Go shaped.
#
# Prefer typed wrappers (`read` / `write` / `open` / …). Use `call` + `SYS_*`
# only when you need a raw trap. SYS_* numbers come from the host kernel ABI.

# --- raw escape hatch ---

pub @func call(nr, ...args) {
    return __syscall(nr, args);
}

# Look up a SYS number by name (arch-correct), e.g. nr("openat").
pub @func nr(name) {
    return __sys_nr(name);
}

pub @func isError(rc) {
    return __sys_isError(rc);
}

pub @func errno(rc) {
    return __sys_errno(rc);
}

pub @func errName(rc) {
    return __sys_errName(rc);
}

# --- typed wrappers ---

pub @func read(fd, buf) {
    return __sys_read(fd, buf);
}

pub @func write(fd, data) {
    return __sys_write(fd, data);
}

pub @func writeAll(fd, data) {
    return __sys_writeAll(fd, data);
}

pub @func open(path, flags, ...rest) {
    @if (len(rest) > 0) {
        return __sys_open(path, flags, rest[0]);
    }
    return __sys_open(path, flags);
}

pub @func close(fd) {
    return __sys_close(fd);
}

pub @func lseek(fd, offset, whence) {
    return __sys_lseek(fd, offset, whence);
}

pub @func fsync(fd) {
    return __sys_fsync(fd);
}

pub @func pipe() {
    return __sys_pipe();
}

pub @func dup(fd) {
    return __sys_dup(fd);
}

pub @func dup2(old_fd, new_fd) {
    return __sys_dup2(old_fd, new_fd);
}

pub @func getpid() {
    return __sys_getpid();
}

pub @func getppid() {
    return __sys_getppid();
}

pub @func getuid() {
    return __sys_getuid();
}

pub @func geteuid() {
    return __sys_geteuid();
}

pub @func getgid() {
    return __sys_getgid();
}

pub @func getegid() {
    return __sys_getegid();
}

pub @func kill(pid, sig) {
    return __sys_kill(pid, sig);
}

pub @func chdir(path) {
    return __sys_chdir(path);
}

pub @func getcwd() {
    return __sys_getcwd();
}

pub @func unlink(path) {
    return __sys_unlink(path);
}

pub @func rename(old_path, new_path) {
    return __sys_rename(old_path, new_path);
}

pub @func mkdir(path, ...rest) {
    @if (len(rest) > 0) {
        return __sys_mkdir(path, rest[0]);
    }
    return __sys_mkdir(path);
}

pub @func rmdir(path) {
    return __sys_rmdir(path);
}

pub @func access(path, ...rest) {
    @if (len(rest) > 0) {
        return __sys_access(path, rest[0]);
    }
    return __sys_access(path);
}

pub @func chmod(path, mode) {
    return __sys_chmod(path, mode);
}

pub @func symlink(target, path) {
    return __sys_symlink(target, path);
}

pub @func readlink(path) {
    return __sys_readlink(path);
}

pub @func ftruncate(fd, len) {
    return __sys_ftruncate(fd, len);
}

pub @func umask(mask) {
    return __sys_umask(mask);
}

pub @func nanosleep(sec, nsec) {
    return __sys_nanosleep(sec, nsec);
}

pub @func fcntl(fd, cmd, ...rest) {
    @if (len(rest) > 0) {
        return __sys_fcntl(fd, cmd, rest[0]);
    }
    return __sys_fcntl(fd, cmd);
}

