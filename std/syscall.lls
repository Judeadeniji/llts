# Low-level OS syscalls — Linux-oriented, Zig/Go shaped.
#
# Prefer typed wrappers (`read` / `write` / `open` / …). Use `call` + `SYS_*`
# only when you need a raw trap. SYS_* numbers come from the host kernel ABI.
#
# Result convention: a wrapper returns the syscall result on success, or a
# runtime error value (with `.code` / `.payload`) on failure. Because the error
# channel is dynamic, results are typed `unknown` — inspect with `@isError`
# and narrow with `@as` once the success path is known.

@const $buffer = @import("./buffer.lls");

# --- raw escape hatch ---

pub @func call(nr: int, ...args: int): unknown {
    return @as(null, __syscall(nr, args));
}

# Look up a SYS number by name (arch-correct), e.g. nr("openat").
pub @func nr(name: string): unknown {
    return @as(null, __sys_nr(name));
}

pub @func isError(rc: unknown): bool {
    return @as(bool, __sys_isError(rc));
}

pub @func errno(rc: unknown): unknown {
    return @as(null, __sys_errno(rc));
}

pub @func errName(rc: unknown): unknown {
    return @as(null, __sys_errName(rc));
}

# --- typed wrappers ---

pub @func read(fd: int, buf: *buffer.Buffer): unknown {
    return @as(null, __sys_read(fd, buf));
}

pub @func write(fd: int, data: string | *buffer.Buffer): unknown {
    return @as(null, __sys_write(fd, data));
}

pub @func writeAll(fd: int, data: string | *buffer.Buffer): unknown {
    return @as(null, __sys_writeAll(fd, data));
}

pub @func open(path: string, flags: int, ...rest: int): unknown {
    @if (len(rest) > 0) {
        return @as(null, __sys_open(path, flags, rest[0]));
    }
    return @as(null, __sys_open(path, flags));
}

pub @func close(fd: int): unknown {
    return @as(null, __sys_close(fd));
}

pub @func lseek(fd: int, offset: int, whence: int): unknown {
    return @as(null, __sys_lseek(fd, offset, whence));
}

pub @func fsync(fd: int): unknown {
    return @as(null, __sys_fsync(fd));
}

pub @func pipe(): unknown {
    return @as(null, __sys_pipe());
}

pub @func dup(fd: int): unknown {
    return @as(null, __sys_dup(fd));
}

pub @func dup2(old_fd: int, new_fd: int): unknown {
    return @as(null, __sys_dup2(old_fd, new_fd));
}

pub @func getpid(): int {
    return @as(int, __sys_getpid());
}

pub @func getppid(): int {
    return @as(int, __sys_getppid());
}

pub @func getuid(): unknown {
    return @as(null, __sys_getuid());
}

pub @func geteuid(): unknown {
    return @as(null, __sys_geteuid());
}

pub @func getgid(): unknown {
    return @as(null, __sys_getgid());
}

pub @func getegid(): unknown {
    return @as(null, __sys_getegid());
}

pub @func kill(pid: int, sig: int): unknown {
    return @as(null, __sys_kill(pid, sig));
}

pub @func chdir(path: string): unknown {
    return @as(null, __sys_chdir(path));
}

pub @func getcwd(): unknown {
    return @as(null, __sys_getcwd());
}

pub @func unlink(path: string): unknown {
    return @as(null, __sys_unlink(path));
}

pub @func rename(old_path: string, new_path: string): unknown {
    return @as(null, __sys_rename(old_path, new_path));
}

pub @func mkdir(path: string, ...rest: int): unknown {
    @if (len(rest) > 0) {
        return @as(null, __sys_mkdir(path, rest[0]));
    }
    return @as(null, __sys_mkdir(path));
}

pub @func rmdir(path: string): unknown {
    return @as(null, __sys_rmdir(path));
}

pub @func access(path: string, ...rest: int): unknown {
    @if (len(rest) > 0) {
        return @as(null, __sys_access(path, rest[0]));
    }
    return @as(null, __sys_access(path));
}

pub @func chmod(path: string, mode: int): unknown {
    return @as(null, __sys_chmod(path, mode));
}

pub @func symlink(target: string, path: string): unknown {
    return @as(null, __sys_symlink(target, path));
}

pub @func readlink(path: string): unknown {
    return @as(null, __sys_readlink(path));
}

pub @func ftruncate(fd: int, len: int): unknown {
    return @as(null, __sys_ftruncate(fd, len));
}

pub @func umask(mask: int): unknown {
    return @as(null, __sys_umask(mask));
}

pub @func nanosleep(sec: int, nsec: int): unknown {
    return @as(null, __sys_nanosleep(sec, nsec));
}

pub @func fcntl(fd: int, cmd: int, ...rest: int): unknown {
    @if (len(rest) > 0) {
        return @as(null, __sys_fcntl(fd, cmd, rest[0]));
    }
    return @as(null, __sys_fcntl(fd, cmd));
}

