# Port of src/bytecode/opcode.zig — numeric values must match the host VM.
# Variants are auto-incrementing from 0 (OP_CONSTANT … OP_ERROR_NAME = 0..69).

pub @enum OpCode {
    OP_CONSTANT,
    OP_NULL,
    OP_TRUE,
    OP_FALSE,
    OP_ADD,
    OP_STRING_ADD,
    OP_SUB,
    OP_MUL,
    OP_DIV,
    OP_MOD,
    OP_POW,
    OP_EQUAL,
    OP_NOT_EQUAL,
    OP_STRING_EQUAL,
    OP_STRING_NOT_EQUAL,
    OP_LESS,
    OP_LESS_EQUAL,
    OP_GREATER,
    OP_GREATER_EQUAL,
    OP_NEGATE,
    OP_NOT,
    OP_DUP,
    OP_MAKE_STRING,
    OP_MAKE_ERROR,
    OP_MAKE_ERROR_PAYLOAD,
    OP_IS_ERROR,
    OP_SET_GLOBAL,
    OP_GET_GLOBAL,
    OP_SET_LOCAL,
    OP_GET_LOCAL,
    OP_GET_INDEX,
    OP_SET_INDEX,
    OP_GET_ARRAY,
    OP_SET_ARRAY,
    OP_JUMP,
    OP_JUMP_IF_FALSE,
    OP_LOOP,
    OP_RETURN,
    OP_IMPORT,
    OP_GET_PROPERTY,
    OP_SET_PROPERTY,
    OP_PRINT,
    OP_POP,
    OP_GET_FUNCTION,
    OP_GET_MODULE,
    OP_CALL,
    OP_CALL_STATIC,
    OP_PACK_REST,
    OP_LINE,
    OP_SOURCE,
    OP_MARK_CONST,
    OP_ASSERT_TYPE,
    OP_SIZEOF,
    OP_BIT_AND,
    OP_BIT_OR,
    OP_BIT_XOR,
    OP_BIT_NOT,
    OP_SHL,
    OP_SHR,
    OP_FOR_PREP,
    OP_FOR_LOOP,
    OP_ADD_TYPED,
    OP_SUB_TYPED,
    OP_MUL_TYPED,
    OP_LT_TYPED,
    OP_LOAD_FIELD,
    OP_STORE_FIELD,
    OP_AS,
    OP_SLICE,
    OP_ERROR_NAME,
}

# Enum variant → u8 opcode byte (same as Zig @intFromEnum).
pub @func byte(op: OpCode) {
    return @as(u8, op);
}
