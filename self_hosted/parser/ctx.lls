# Port of src/parser/ctx.zig (token cursor over scanner parallel lists).

@const $tokens = @import("../scanner/tokens.lls");
@const $common = @import("../ast/common.lls");
@const $list = @import("std/list.lls");
@const $string = @import("std/string.lls");
@const $debug = @import("std/debug.lls");

pub @struct Parser {
    kinds: unknown;
    values: unknown;
    lines: unknown;
    columns: unknown;
    current: i64;
    path: string;
    source: string;
    arena: unknown;

    @func tokenCount(self: *Parser) {
        return list.len(self.kinds);
    }

    @func isAtEnd(self: *Parser) {
        @if (self.current >= list.len(self.kinds)) {
            return true;
        }
        $k: tokens.TokenType = @as(tokens.TokenType, list.get(self.kinds, self.current));
        return k == tokens.TokenType.Eof;
    }

    @func kind(self: *Parser): tokens.TokenType {
        @if (self.current >= list.len(self.kinds)) {
            return tokens.TokenType.Eof;
        }
        return @as(tokens.TokenType, list.get(self.kinds, self.current));
    }

    @func value(self: *Parser): string {
        @if (self.current >= list.len(self.values)) {
            return "";
        }
        return list.get(self.values, self.current);
    }

    @func line(self: *Parser) {
        @if (self.current >= list.len(self.lines)) {
            return 0;
        }
        return list.get(self.lines, self.current);
    }

    @func column(self: *Parser) {
        @if (self.current >= list.len(self.columns)) {
            return 0;
        }
        return list.get(self.columns, self.current);
    }

    # Token just consumed (index current-1).
    @func prevKind(self: *Parser): tokens.TokenType {
        @if (self.current <= 0) {
            return tokens.TokenType.Eof;
        }
        return @as(tokens.TokenType, list.get(self.kinds, self.current - 1));
    }

    @func prevValue(self: *Parser): string {
        @if (self.current <= 0) {
            return "";
        }
        return list.get(self.values, self.current - 1);
    }

    @func prevLoc(self: *Parser): common.Location {
        @if (self.current <= 0) {
            return common.Location { line: 0, column: 0, path: self.path };
        }
        return common.Location {
            line: list.get(self.lines, self.current - 1),
            column: list.get(self.columns, self.current - 1),
            path: self.path,
        };
    }

    @func locHere(self: *Parser): common.Location {
        return common.Location { line: self.line(), column: self.column(), path: self.path };
    }

    # If current token is `typ`, return its value (does not advance).
    @func ifKind(self: *Parser, typ: tokens.TokenType): ?string {
        @if (self.isAtEnd() || self.kind() != typ) {
            return null;
        }
        return self.value();
    }

    @func check(self: *Parser, typ: tokens.TokenType) {
        return !self.isAtEnd() && self.kind() == typ;
    }

    # Lookahead without advancing. Offset 0 = current.
    @func peekKind(self: *Parser, offset: i64): tokens.TokenType {
        $i = self.current + offset;
        @if (i < 0 || i >= list.len(self.kinds)) {
            return tokens.TokenType.Eof;
        }
        return @as(tokens.TokenType, list.get(self.kinds, i));
    }

    @func peekValue(self: *Parser, offset: i64): string {
        $i = self.current + offset;
        @if (i < 0 || i >= list.len(self.values)) {
            return "";
        }
        return list.get(self.values, i);
    }

    @func checkDelim(self: *Parser, want: string) {
        @if (self.isAtEnd() || !string.eql(self.value(), want)) {
            return false;
        }
        $k = self.kind();
        @if (k == tokens.TokenType.Delimiter) {
            return true;
        }
        return k == tokens.TokenType.BinOp && (string.eql(want, "|") || string.eql(want, "*") || string.eql(want, "&"));
    }

    @func advance(self: *Parser) {
        @if (!self.isAtEnd()) {
            self.current = self.current + 1;
        }
    }

    @func match(self: *Parser, typ: tokens.TokenType) {
        @if (self.check(typ)) {
            self.advance();
            return true;
        }
        return false;
    }

    @func consume(self: *Parser, typ: tokens.TokenType, message: string, want: ?string) {
        @if (want) |v| {
            $k = self.kind();
            $type_ok = self.check(typ) || (typ == tokens.TokenType.Delimiter && k == tokens.TokenType.BinOp && (string.eql(v, "|") || string.eql(v, "*") || string.eql(v, "&")));
            $ok = (string.eql(self.value(), v) && type_ok) || k == tokens.TokenType.Eof;
            @if (!ok) {
                return self.fail(message);
            }
            self.advance();
            return;
        }
        @if (!self.check(typ)) {
            return self.fail(message);
        }
        self.advance();
    }

    @func fail(self: *Parser, message: string) {
        debug.err(message);
        debug.printLn("  --> {s}:{i}:{i}", self.path, self.line(), self.column());
        return error("ParseFailed", message);
    }
}

pub @func fromLists(arena, kinds, values, lines, columns, path: string, source: string): *Parser {
    return @new(arena, Parser {
        kinds: kinds,
        values: values,
        lines: lines,
        columns: columns,
        current: 0,
        path: path,
        source: source,
        arena: arena,
    });
}
