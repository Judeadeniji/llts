@func emBinOp(em: *EmState, op: string) {
    @if (string.eql(op, "+")) {
        em.chunk.writeOp(opcode.OpCode.OP_ADD);
        return;
    }
    @if (string.eql(op, "-")) {
        em.chunk.writeOp(opcode.OpCode.OP_SUB);
        return;
    }
    @if (string.eql(op, "*")) {
        em.chunk.writeOp(opcode.OpCode.OP_MUL);
        return;
    }
    @if (string.eql(op, "/")) {
        em.chunk.writeOp(opcode.OpCode.OP_DIV);
        return;
    }
    @if (string.eql(op, "%")) {
        em.chunk.writeOp(opcode.OpCode.OP_MOD);
        return;
    }
    @if (string.eql(op, "==")) {
        em.chunk.writeOp(opcode.OpCode.OP_EQUAL);
        return;
    }
    @if (string.eql(op, "!=")) {
        em.chunk.writeOp(opcode.OpCode.OP_NOT_EQUAL);
        return;
    }
    @if (string.eql(op, "<")) {
        em.chunk.writeOp(opcode.OpCode.OP_LESS);
        return;
    }
    @if (string.eql(op, "<=")) {
        em.chunk.writeOp(opcode.OpCode.OP_LESS_EQUAL);
        return;
    }
    @if (string.eql(op, ">")) {
        em.chunk.writeOp(opcode.OpCode.OP_GREATER);
        return;
    }
    @if (string.eql(op, ">=")) {
        em.chunk.writeOp(opcode.OpCode.OP_GREATER_EQUAL);
        return;
    }
    @if (string.eql(op, "**") || string.eql(op, "^")) {
        em.chunk.writeOp(opcode.OpCode.OP_POW);
        return;
    }
    return error("EmitUnsupported", "binary op");
}

@func emLiteral(em: *EmState, lit: *nodes.Literal) {
    @if (lit.literal_type == nodes.LiteralKind.Null) {
        em.chunk.writeOp(opcode.OpCode.OP_NULL);
        return;
    }
    @if (lit.literal_type == nodes.LiteralKind.Boolean) {
        @if (string.eql(lit.value, "true")) {
            em.chunk.writeOp(opcode.OpCode.OP_TRUE);
        } @else {
            em.chunk.writeOp(opcode.OpCode.OP_FALSE);
        }
        return;
    }
    @if (lit.literal_type == nodes.LiteralKind.String) {
        em.chunk.emitString(lit.value);
        return;
    }
    @if (lit.literal_type == nodes.LiteralKind.Number) {
        @if (string.indexOf(lit.value, ".") >= 0) {
            # Runtime parse — avoid needing float bits in the constant pool yet.
            em.chunk.emitGetGlobal("__parseFloat");
            em.chunk.emitString(lit.value);
            em.chunk.writeOp(opcode.OpCode.OP_CALL);
            em.chunk.writeByte(1);
            return;
        }
        em.chunk.emitConstantInt(string.parseInt(lit.value, 10));
        return;
    }
    @if (lit.literal_type == nodes.LiteralKind.Hex) {
        em.chunk.emitConstantInt(string.parseInt(string.slice(lit.value, 2, string.len(lit.value)), 16));
        return;
    }
    @if (lit.literal_type == nodes.LiteralKind.Octal) {
        em.chunk.emitConstantInt(string.parseInt(string.slice(lit.value, 2, string.len(lit.value)), 8));
        return;
    }
    @if (lit.literal_type == nodes.LiteralKind.Binary) {
        em.chunk.emitConstantInt(string.parseInt(string.slice(lit.value, 2, string.len(lit.value)), 2));
        return;
    }
    return error("EmitUnsupported", "literal kind");
}

@func emResolveName(em: *EmState, name: string) {
    $emSlot = emResolveLocal(em, name);
    @if (emSlot >= 0) {
        em.chunk.emitGetLocal(emSlot);
        return;
