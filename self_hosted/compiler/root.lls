        return;
    }
    @if (n.kind == common.NodeKind.Switch) {
        emSwitchValue(em, @as(*nodes.Switch, n))?;
        return;
    }
    @if (n.kind == common.NodeKind.Block) {
        emBlockValue(em, @as(*nodes.Block, n))?;
        return;
