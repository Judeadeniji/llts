# Self-hosted emit — growing toward 1:1 with Zig `src/compiler` emit.
# Gate for pointing at examples/: full parity (`examples_smoke --all` green).
#
# Note: host LLTS shares `$` register types across a module — use unique em* names.

@const $parser = @import("../parser/root.lls");
@const $ast = @import("../ast/root.lls");
@const $nodes = @import("../ast/nodes.lls");
@const $common = @import("../ast/common.lls");
@const $chunk_mod = @import("../bytecode/chunk.lls");
@const $opcode = @import("../bytecode/opcode.lls");
@const $serialize = @import("../bytecode/serialize.lls");
@const $intrinsics = @import("./intrinsics.lls");
@const $list = @import("std/list.lls");
@const $map = @import("std/map.lls");
@const $string = @import("std/string.lls");
@const $mem = @import("std/mem.lls");

@struct EmLocal {
    name: string;
    depth: i64;
    type_name: string;
}

@struct EmLoop {
    scope_depth: i64;
    label: string;
    break_jumps: unknown;
    continue_jumps: unknown;
}

@struct EmExprFrame {
    scope_depth: i64;
    result_slot: i64;
    label: string;
    break_jumps: unknown;
}

@struct EmFunc {
    name: string;
    node: *nodes.Node;
    address: i64;
    arity: i64;
    patches: unknown;
}

@struct EmStructDef {
    name: string;
    size: i64;
    field_names: unknown;
    field_offsets: unknown;
    field_types: unknown;
    field_kinds: unknown;
}

@struct EmEnumDef {
    name: string;
    variant_names: unknown;
    variant_vals: unknown;
}

@struct EmState {
    arena: mem.Arena;
    chunk: *chunk_mod.Chunk;
    locals: unknown;
    scope_depth: i64;
    functions: unknown;
    loops: unknown;
    exprs: unknown;
    structs: unknown;
    enums: unknown;
    var_types: unknown;
}

@func emCreateState(arena: mem.Arena, path: string): *EmState {
    return @new(arena, EmState {
        arena: arena,
        chunk: chunk_mod.create(arena, path),
        locals: list.create(arena),
        scope_depth: 0,
        functions: list.create(arena),
        loops: list.create(arena),
        exprs: list.create(arena),
        structs: map.create(arena),
        enums: map.create(arena),
        var_types: map.create(arena),
    });
}

@func emBeginScope(em: *EmState) {
    em.scope_depth = em.scope_depth + 1;
}

@func emEndScope(em: *EmState) {
    @for (true) {
        @if (list.len(em.locals) == 0) {
            break;
        }
        $emLoc: *EmLocal = @as(*EmLocal, list.get(em.locals, list.len(em.locals) - 1));
        @if (emLoc.depth != em.scope_depth) {
            break;
        }
        _ = list.pop(em.locals);
        em.chunk.writeOp(opcode.OpCode.OP_POP);
    }
    em.scope_depth = em.scope_depth - 1;
}

@func emPopsUntil(em: *EmState, target_depth: i64) {
    $emCount = 0;
    $emIdx = list.len(em.locals) - 1;
    @for (true) {
        @if (emIdx < 0) {
            break;
        }
        $emLoc2: *EmLocal = @as(*EmLocal, list.get(em.locals, emIdx));
        @if (emLoc2.depth > target_depth) {
            emCount = emCount + 1;
            emIdx = emIdx - 1;
        } @else {
            break;
        }
    }
    @for (0..emCount) |_| {
        em.chunk.writeOp(opcode.OpCode.OP_POP);
    }
}

@func emResolveLocal(em: *EmState, name: string) {
    $emIdx2 = list.len(em.locals) - 1;
    @for (true) {
        @if (emIdx2 < 0) {
            return -1;
        }
        $emLoc3: *EmLocal = @as(*EmLocal, list.get(em.locals, emIdx2));
        @if (string.eql(emLoc3.name, name)) {
            return emIdx2;
        }
        emIdx2 = emIdx2 - 1;
    }
    return -1;
}

@func emFindFunc(em: *EmState, name: string): ?*EmFunc {
    @for (0..list.len(em.functions)) |emFi| {
        $emFn: *EmFunc = @as(*EmFunc, list.get(em.functions, emFi));
        @if (string.eql(emFn.name, name)) {
            return emFn;
        }
    }
    return null;
}

@func emPushLocal(em: *EmState, name: string) {
    list.push(em.locals, @new(em.arena, EmLocal {
        name: name,
        depth: em.scope_depth,
        type_name: "",
    }));
    return list.len(em.locals) - 1;
}

@func emPushLocalTyped(em: *EmState, name: string, type_name: string) {
    $emSlotT = emPushLocal(em, name);
    $emLocT: *EmLocal = @as(*EmLocal, list.get(em.locals, emSlotT));
    emLocT.type_name = type_name;
    @if (string.len(type_name) > 0) {
        map.set(em.var_types, name, type_name);
    }
    return emSlotT;
}

@func emSetVarType(em: *EmState, name: string, type_name: string) {
    @if (string.len(type_name) == 0) {
        return;
    }
    map.set(em.var_types, name, type_name);
    $emSlotV = emResolveLocal(em, name);
    @if (emSlotV >= 0) {
        $emLocV: *EmLocal = @as(*EmLocal, list.get(em.locals, emSlotV));
        emLocV.type_name = type_name;
    }
}

@func emGetVarType(em: *EmState, name: string) {
    @if (map.has(em.var_types, name)) {
        return map.get(em.var_types, name);
    }
    return "";
}

@func emTypeDisplay(n: ?*nodes.Node) {
    @if (n == null) {
        return "int";
    }
    $emTn: *nodes.Node = @as(*nodes.Node, n);
    @if (emTn.kind == common.NodeKind.Primary) {
        $emTp: *nodes.Primary = @as(*nodes.Primary, emTn);
        return emTp.name;
    }
    @if (emTn.kind == common.NodeKind.PointerType) {
        $emPtr: *nodes.PointerType = @as(*nodes.PointerType, emTn);
        $emInner: ?*nodes.Node = emPtr.elem;
        return string.concat("*", emTypeDisplay(emInner));
    }
    return "int";
}

@func emFieldKind(ty: string) {
    @if (string.eql(ty, "bool") || string.eql(ty, "boolean") || string.eql(ty, "u1")) {
        return 2;
    }
    @if (string.eql(ty, "string") || string.eql(ty, "[]byte")) {
        return 3;
    }
    @if (string.len(ty) > 0) {
        @if (string.eql(string.slice(ty, 0, 1), "*")) {
            return 3;
        }
    }
    @if (string.eql(ty, "f32") || string.eql(ty, "f64") || string.eql(ty, "float")) {
        return 1;
    }
    return 0;
}

@func emFindStruct(em: *EmState, name: string): ?*EmStructDef {
    @if (map.has(em.structs, name)) {
        return @as(*EmStructDef, map.get(em.structs, name));
    }
    return null;
}

@func emFindEnum(em: *EmState, name: string): ?*EmEnumDef {
    @if (map.has(em.enums, name)) {
        return @as(*EmEnumDef, map.get(em.enums, name));
    }
    return null;
}

@func emEnumVariantValue(ed: *EmEnumDef, variant: string) {
    @for (0..list.len(ed.variant_names)) |emVi| {
        @if (string.eql(list.get(ed.variant_names, emVi), variant)) {
            return list.get(ed.variant_vals, emVi);
        }
    }
    return -1;
}

# Width discriminant for OP_AS (must stay in sync with Zig widths.Width).
@func emTyWidth(ty: string) {
    return -1;
}

@func emSizeOfName(em: *EmState, tyName: string) {
    return 8;
}

@func emInferTypeOf(em: *EmState, emInfNode: *nodes.Node) {
    return "unknown";
}

@func emFieldIndex(sd: *EmStructDef, field: string) {
    @for (0..list.len(sd.field_names)) |emFi| {
        @if (string.eql(list.get(sd.field_names, emFi), field)) {
            return emFi;
        }
    }
    return -1;
}

@func emRegisterStructs(em: *EmState, doc: *ast.Document) {
    @for (0..list.len(doc.statements)) |emDi| {
        $emStmt: *nodes.Node = @as(*nodes.Node, list.get(doc.statements, emDi));
        @if (emStmt.kind == common.NodeKind.StructDecl) {
            $emSd: *nodes.StructDecl = @as(*nodes.StructDecl, emStmt);
            $emNames = list.create(em.arena);
            $emOffs = list.create(em.arena);
            $emTys = list.create(em.arena);
            $emKinds = list.create(em.arena);
            $emOff = 0;
            @for (0..list.len(emSd.fields)) |emFi| {
                $emField: *nodes.StructField = @as(*nodes.StructField, list.get(emSd.fields, emFi));
                $emFty = emTypeDisplay(emField.type_annotation);
                list.push(emNames, emField.name);
                list.push(emOffs, emOff);
                list.push(emTys, emFty);
                list.push(emKinds, emFieldKind(emFty));
                emOff = emOff + 8;
            }
            $emSize = emOff;
            @if (emSize == 0) {
                emSize = 0;
            }
            $emDef = @new(em.arena, EmStructDef {
                name: emSd.name,
                size: emSize,
                field_names: emNames,
                field_offsets: emOffs,
                field_types: emTys,
                field_kinds: emKinds,
            });
            map.set(em.structs, emSd.name, emDef);

            @for (0..list.len(emSd.methods)) |emMi| {
                $emMeth: *nodes.Node = @as(*nodes.Node, list.get(emSd.methods, emMi));
                @if (emMeth.kind == common.NodeKind.FunctionDecl) {
                    $emMfd: *nodes.FunctionDecl = @as(*nodes.FunctionDecl, emMeth);
                    $emQ = string.concat(string.concat(emSd.name, "::"), emMfd.name);
                    emMfd.name = emQ;
                    $emMarity = 0;
                    @if (emMfd.params.kind == common.NodeKind.Params) {
                        $emMps: *nodes.Params = @as(*nodes.Params, emMfd.params);
                        emMarity = list.len(emMps.params);
                    }
                    list.push(em.functions, @new(em.arena, EmFunc {
                        name: emQ,
                        node: emMeth,
                        address: -1,
                        arity: emMarity,
                        patches: list.create(em.arena),
                    }));
                }
            }
        }
    }
}

@func emRegisterEnums(em: *EmState, doc: *ast.Document) {
    @for (0..list.len(doc.statements)) |emDi| {
        $emStmt: *nodes.Node = @as(*nodes.Node, list.get(doc.statements, emDi));
        @if (emStmt.kind == common.NodeKind.EnumDecl) {
            $emEd: *nodes.EnumDecl = @as(*nodes.EnumDecl, emStmt);
            $emVNames = list.create(em.arena);
            $emVVals = list.create(em.arena);
            @for (0..list.len(emEd.variants)) |emVi| {
                list.push(emVNames, list.get(emEd.variants, emVi));
                list.push(emVVals, emVi);
            }
            map.set(em.enums, emEd.name, @new(em.arena, EmEnumDef {
                name: emEd.name,
                variant_names: emVNames,
                variant_vals: emVVals,
            }));
        }
    }
}

@func emBeginExprFrame(em: *EmState, label: string) {
    emBeginScope(em);
    em.chunk.writeOp(opcode.OpCode.OP_NULL);
    $emRSlot = emPushLocal(em, "");
    list.push(em.exprs, @new(em.arena, EmExprFrame {
        scope_depth: em.scope_depth,
        result_slot: emRSlot,
        label: label,
        break_jumps: list.create(em.arena),
    }));
}

@func emFinishExprFrame(em: *EmState) {
    @if (list.len(em.exprs) == 0) {
        return error("Emit", "expr frame empty");
    }
    $emFr: *EmExprFrame = @as(*EmExprFrame, list.pop(em.exprs));
    @for (0..list.len(emFr.break_jumps)) |emBj| {
        em.chunk.patchJump(list.get(emFr.break_jumps, emBj));
    }
    @if (list.len(em.locals) == 0) {
        return error("Emit", "expr result missing");
    }
    _ = list.pop(em.locals);
    em.scope_depth = em.scope_depth - 1;
}

@func emFindExpr(em: *EmState, label: ?string): ?*EmExprFrame {
    $emEi = list.len(em.exprs) - 1;
    @for (true) {
        @if (emEi < 0) {
            return null;
        }
        $emFr2: *EmExprFrame = @as(*EmExprFrame, list.get(em.exprs, emEi));
        @if (label == null) {
            return emFr2;
        }
        $emWant: string = @as(string, label);
        @if (string.eql(emFr2.label, emWant)) {
            return emFr2;
        }
        emEi = emEi - 1;
    }
    return null;
}

@func emBlockValue(em: *EmState, b: *nodes.Block) {
    @if (b.label == null) {
        return error("EmitUnsupported", "value block needs label");
    }
    $emBlab: string = @as(string, b.label);
    emBeginExprFrame(em, emBlab);
    emBeginScope(em);
    @for (0..list.len(b.statements)) |emSi| {
        emStatement(em, @as(*nodes.Node, list.get(b.statements, emSi)))?;
    }
    emEndScope(em);
    emFinishExprFrame(em)?;
}

@func emArrayLiteral(em: *EmState, arr: *nodes.ArrayLiteral) {
    $emAlen = list.len(arr.elements);
    em.chunk.emitGetGlobal("__allocImmortalArray");
    em.chunk.emitConstantInt(emAlen);
    em.chunk.writeOp(opcode.OpCode.OP_CALL);
    em.chunk.writeByte(1);
    @for (0..emAlen) |emAi| {
        em.chunk.writeOp(opcode.OpCode.OP_DUP);
        em.chunk.emitConstantInt(emAi);
        emExpr(em, @as(*nodes.Node, list.get(arr.elements, emAi)))?;
        em.chunk.writeOp(opcode.OpCode.OP_SET_ARRAY);
        em.chunk.writeOp(opcode.OpCode.OP_POP);
    }
}

@func emIndex(em: *EmState, idx: *nodes.Index) {
    emExpr(em, idx.object)?;
    @if (idx.is_slice) {
        @if (idx.index != null) {
            emExpr(em, @as(*nodes.Node, idx.index))?;
        } @else {
            em.chunk.emitConstantInt(0);
        }
        @if (idx.end != null) {
            emExpr(em, @as(*nodes.Node, idx.end))?;
        } @else {
            em.chunk.writeOp(opcode.OpCode.OP_NULL);
        }
        em.chunk.writeOp(opcode.OpCode.OP_SLICE);
        return;
    }
    @if (idx.index == null) {
        return error("EmitUnsupported", "index");
    }
    emExpr(em, @as(*nodes.Node, idx.index))?;
    em.chunk.writeOp(opcode.OpCode.OP_GET_ARRAY);
}

@func emAssignIndex(em: *EmState, idx: *nodes.Index, right: *nodes.Node, op: string) {
    @if (idx.is_slice || idx.index == null) {
        return error("EmitUnsupported", "index assign");
    }
    @if (string.eql(op, "=") == false) {
        emExpr(em, idx.object)?;
        emExpr(em, @as(*nodes.Node, idx.index))?;
        emExpr(em, idx.object)?;
        emExpr(em, @as(*nodes.Node, idx.index))?;
        em.chunk.writeOp(opcode.OpCode.OP_GET_ARRAY);
        emExpr(em, right)?;
        @if (string.eql(op, "+=")) {
            em.chunk.writeOp(opcode.OpCode.OP_ADD);
        } @else {
            return error("EmitUnsupported", "compound index");
        }
        em.chunk.writeOp(opcode.OpCode.OP_SET_ARRAY);
        return;
    }
    emExpr(em, idx.object)?;
    emExpr(em, @as(*nodes.Node, idx.index))?;
    emExpr(em, right)?;
    em.chunk.writeOp(opcode.OpCode.OP_SET_ARRAY);
}

@func emSwitchValue(em: *EmState, sw: *nodes.Switch) {
    @if (sw.label != null) {
        emBeginExprFrame(em, @as(string, sw.label));
    } @else {
        emBeginExprFrame(em, "");
    }
    emBeginScope(em);
    emExpr(em, sw.condition)?;
    $emScrut = emPushLocal(em, "");
    $emEnds = list.create(em.arena);
    @for (0..list.len(sw.prongs)) |emPi| {
        $emPr: *nodes.SwitchProng = @as(*nodes.SwitchProng, list.get(sw.prongs, emPi));
        @if (emPr.is_else) {
            emBeginScope(em);
            @if (emPr.body.kind == common.NodeKind.Block) {
                $emEb: *nodes.Block = @as(*nodes.Block, emPr.body);
                @for (0..list.len(emEb.statements)) |emSi| {
                    emStatement(em, @as(*nodes.Node, list.get(emEb.statements, emSi)))?;
                }
            } @else {
                emStatement(em, emPr.body)?;
            }
            emEndScope(em);
            list.push(emEnds, em.chunk.emitJump(opcode.OpCode.OP_JUMP));
        } @else {
            @if (list.len(emPr.patterns) != 1) {
                return error("EmitUnsupported", "multi-pattern switch");
            }
            em.chunk.emitGetLocal(emScrut);
            emExpr(em, @as(*nodes.Node, list.get(emPr.patterns, 0)))?;
            em.chunk.writeOp(opcode.OpCode.OP_EQUAL);
            $emNoMatch = em.chunk.emitJump(opcode.OpCode.OP_JUMP_IF_FALSE);
            em.chunk.writeOp(opcode.OpCode.OP_POP);
            emBeginScope(em);
            @if (emPr.body.kind == common.NodeKind.Block) {
                $emPb: *nodes.Block = @as(*nodes.Block, emPr.body);
                @for (0..list.len(emPb.statements)) |emSi2| {
                    emStatement(em, @as(*nodes.Node, list.get(emPb.statements, emSi2)))?;
                }
            } @else {
                emStatement(em, emPr.body)?;
            }
            emEndScope(em);
            list.push(emEnds, em.chunk.emitJump(opcode.OpCode.OP_JUMP));
            em.chunk.patchJump(emNoMatch);
            em.chunk.writeOp(opcode.OpCode.OP_POP);
        }
    }
    @for (0..list.len(emEnds)) |emEi| {
        em.chunk.patchJump(list.get(emEnds, emEi));
    }
    emEndScope(em);
    emFinishExprFrame(em)?;
}

@func emArgNode(args, i: int): *nodes.Node {
    return @as(*nodes.Node, list.get(args, i));
}

# Port of src/compiler/intrinsics.zig `compile` — switch on Intrinsic.
@func compileIntrinsic(em: *EmState, intr: intrinsics.Intrinsic, name: string, args) {
    intrinsics.checkArity(intr, name, list.len(args))?;
    @switch (intr) {
        intrinsics.Intrinsic.import => {
            emExpr(em, emArgNode(args, 0))?;
            em.chunk.writeOp(opcode.OpCode.OP_POP);
        }
        intrinsics.Intrinsic.isError => {
            emExpr(em, emArgNode(args, 0))?;
            em.chunk.writeOp(opcode.OpCode.OP_IS_ERROR);
        }
        intrinsics.Intrinsic.typeOf => {
            emExpr(em, emArgNode(args, 0))?;
            em.chunk.writeOp(opcode.OpCode.OP_POP);
            em.chunk.emitString("unknown");
        }
        intrinsics.Intrinsic.sizeOf => {
            $arg0 = emArgNode(args, 0);
            @if (arg0.kind == common.NodeKind.Primary) {
                $p: *nodes.Primary = @as(*nodes.Primary, arg0);
                $sz = intrinsics.sizeOfTypeName(p.name);
                @if (sz != null) {
                    em.chunk.emitConstantInt(sz);
                    return;
                }
                $sd = emFindStruct(em, p.name);
                @if (sd != null) {
                    $def: *EmStructDef = @as(*EmStructDef, sd);
                    em.chunk.emitConstantInt(def.size);
                    return;
                }
            }
            emExpr(em, arg0)?;
            em.chunk.writeOp(opcode.OpCode.OP_SIZEOF);
        }
        intrinsics.Intrinsic.nameOf => {
            emExpr(em, emArgNode(args, 0))?;
            em.chunk.writeOp(opcode.OpCode.OP_ERROR_NAME);
        }
        intrinsics.Intrinsic.as => {
            compileCast(em, emArgNode(args, 0), emArgNode(args, 1))?;
        }
        intrinsics.Intrinsic.new => {
            return error("EmitUnsupported", "@new");
        }
    }
}

# Port of compileCast / asCastKind.
@func compileCast(em: *EmState, type_node: *nodes.Node, value: *nodes.Node) {
    $kind = intrinsics.asCastKind(type_node);
    emExpr(em, value)?;
    @if (kind != null) {
        em.chunk.writeOp(opcode.OpCode.OP_AS);
        em.chunk.writeByte(kind);
    }
}

@func emIntrinsic(em: *EmState, name: string, args) {
    $intr = intrinsics.match(name);
    @if (intr == null) {
        return error("EmitUnsupported", "intrinsic");
    }
    compileIntrinsic(em, intr, name, args)?;
}

@func emStructInit(em: *EmState, init: *nodes.StructInit) {
    @if (init.type_expr.kind != common.NodeKind.Primary) {
        return error("EmitUnsupported", "struct type");
    }
    $emTyP: *nodes.Primary = @as(*nodes.Primary, init.type_expr);
    $emSd2o = emFindStruct(em, emTyP.name);
    @if (emSd2o == null) {
        return error("EmitUnsupported", "unknown struct");
    }
    $emSd2: *EmStructDef = @as(*EmStructDef, emSd2o);
    em.chunk.emitGetGlobal("__allocImmortalBytes");
    em.chunk.emitConstantInt(emSd2.size);
    em.chunk.writeOp(opcode.OpCode.OP_CALL);
    em.chunk.writeByte(1);
    @for (0..list.len(init.fields)) |emFi2| {
        $emFiN: *nodes.StructFieldInit = @as(*nodes.StructFieldInit, list.get(init.fields, emFi2));
        $emIdx = emFieldIndex(emSd2, emFiN.name);
        @if (emIdx < 0) {
            return error("EmitUnsupported", "unknown field");
        }
        em.chunk.writeOp(opcode.OpCode.OP_DUP);
        emExpr(em, emFiN.value)?;
        em.chunk.emitStoreField(list.get(emSd2.field_offsets, emIdx), list.get(emSd2.field_kinds, emIdx));
        em.chunk.writeOp(opcode.OpCode.OP_POP);
    }
}

@func emMember(em: *EmState, mem: *nodes.Member) {
    @if (mem.property.kind != common.NodeKind.Primary) {
        return error("EmitUnsupported", "member prop");
    }
    $emProp: *nodes.Primary = @as(*nodes.Primary, mem.property);
    @if (mem.object.kind == common.NodeKind.Primary) {
        $emObj: *nodes.Primary = @as(*nodes.Primary, mem.object);
        $emEno = emFindEnum(em, emObj.name);
        @if (emEno != null) {
            $emEn: *EmEnumDef = @as(*EmEnumDef, emEno);
            $emEv = emEnumVariantValue(emEn, emProp.name);
            @if (emEv < 0) {
                return error("EmitUnsupported", "enum variant");
            }
            em.chunk.emitConstantInt(emEv);
            return;
        }
        $emOt = emGetVarType(em, emObj.name);
        @if (string.len(emOt) > 0) {
            $emSd3o = emFindStruct(em, emOt);
            @if (emSd3o != null) {
                $emSd3: *EmStructDef = @as(*EmStructDef, emSd3o);
                $emIdx2 = emFieldIndex(emSd3, emProp.name);
                @if (emIdx2 >= 0) {
