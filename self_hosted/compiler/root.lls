@func emContinue(em: *EmState, cont: *nodes.Continue) {
    $emTarget2o = emFindLoop(em, cont.label);
    @if (emTarget2o == null) {
        return error("EmitUnsupported", "continue outside loop");
    }
    $emTarget2: *EmLoop = @as(*EmLoop, emTarget2o);
    emPopsUntil(em, emTarget2.scope_depth);
    $emCoJ = em.chunk.emitJump(opcode.OpCode.OP_JUMP);
