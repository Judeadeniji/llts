# Port of src/compiler/root.zig — orchestration: analyze → emitBytecode.
# Split per the Zig module graph: expr/ + stmt/ + state + scope + layout + typecheck.

@const $parser = @import("../parser/root.lls");
@const $ast = @import("../ast/root.lls");
@const $nodes = @import("../ast/nodes.lls");
@const $common = @import("../ast/common.lls");
@const $chunk_mod = @import("../bytecode/chunk.lls");
@const $opcode = @import("../bytecode/opcode.lls");
@const $serialize = @import("../bytecode/serialize.lls");
@const $state_mod = @import("./state.lls");
@const $stmt = @import("./stmt/root.lls");
@const $modules = @import("./modules.lls");
@const $list = @import("std/list.lls");
@const $map = @import("std/map.lls");
@const $string = @import("std/string.lls");
@const $mem = @import("std/mem.lls");
@const $typecheck = @import("./typecheck.lls");
@const $layout = @import("./layout.lls");

# analyze: imports, struct/enum/typedef/function registration (Zig `analyze`).
pub @func analyze(arena: mem.Arena, doc: *ast.Document) {
    $em = state_mod.emCreateState(arena, doc.path);
    modules.resolveImports(em, doc)?;
    registerStructNames(em, doc);
    registerFunctions(em, doc);
    registerModuleDecls(em, doc);
    return em;
}

# emitBytecode: emit reachable functions, trampolined skip chain, top level, main.
pub @func emitBytecode(em: *state_mod.EmState, doc: *ast.Document) {
    # Skip over function bodies to top-level. OP_JUMP is u16-relative, so chain
    # trampolines every ~60KiB when the function blob exceeds one hop.
    $skip_jump = em.chunk.emitJump(opcode.OpCode.OP_JUMP);
    $skip_base: i64 = 0; # code index of the jump operand being chained from

    @for (0..list.len(em.functions)) |fi| {
        $def: *state_mod.EmFunc = @as(*state_mod.EmFunc, list.get(em.functions, fi));
        @if (def.address >= 0) {
            continue; # already emitted
        }

        # Near the u16 jump limit from the current skip hop — land here and hop again.
        $dist = em.chunk.codeLen() - skip_base;
        @if (dist > 61440) { # 0xf000
            em.chunk.patchJump(skip_jump);
            skip_jump = em.chunk.emitJump(opcode.OpCode.OP_JUMP);
            skip_base = em.chunk.codeLen() - 2;
        }

        def.address = em.chunk.codeLen();

        @for (0..list.len(def.patches)) |pi| {
            $patch = list.get(def.patches, pi);
            em.chunk.setByte(patch, @as(u8, (def.address >> 8) & 255));
            em.chunk.setByte(patch + 1, @as(u8, def.address & 255));
        }

        em.chunk.addFunction(def.name, def.address, def.arity);
        func.compileFunction(em, @as(*nodes.FunctionDecl, def.node), def.node)?;
    }

    em.chunk.patchJump(skip_jump);

    @for (0..list.len(doc.statements)) |si| {
        $s: *nodes.Node = @as(*nodes.Node, list.get(doc.statements, si));
        @if (s.kind != common.NodeKind.FunctionDecl && s.kind != common.NodeKind.StructDecl && s.kind != common.NodeKind.EnumDecl && s.kind != common.NodeKind.ErrorDecl && s.kind != common.NodeKind.TypeDecl) {
            stmt.compileStatement(em, s)?;
        }
    }

    # Language entry: pub zero-arg `main` runs after top-level statements.
    $main_fn = state_mod.emFindFunc(em, "main");
    @if (main_fn == null) {
        return error("CompileError", "missing entry point 'main'");
    }
    $main_def: *state_mod.EmFunc = @as(*state_mod.EmFunc, main_fn);
    @if (main_def.is_public == false) {
        return error("CompileError", "entry point 'main' must be pub");
    }
    @if (main_def.arity != 0) {
        return error("CompileError", "'main' must take 0 arguments");
    }
    @if (main_def.address >= 0 && main_def.address <= 65535) {
        em.chunk.emitCallStatic(main_def.address, 0);
    } @else {
        em.chunk.emitGetFunction("main");
        em.chunk.writeOp(opcode.OpCode.OP_CALL);
        em.chunk.writeByte(0);
    }
    em.chunk.writeOp(opcode.OpCode.OP_POP); # discard main's return value

    em.chunk.writeOp(opcode.OpCode.OP_NULL);
    em.chunk.writeOp(opcode.OpCode.OP_RETURN);
    return em.chunk;
}

# compile: analyze + emitBytecode (Zig `compile`).
pub @func compile(arena: mem.Arena, doc: *ast.Document) {
    $em = analyze(arena, doc)?;
    return emitBytecode(em, doc)?;
}

pub @func compileSource(arena: mem.Arena, source: string, path: string) {
    $parsed = parser.parse(arena, source, path);
    @if (@isError(parsed)) {
        return parsed;
    }
    $doc: *ast.Document = @as(*ast.Document, parsed);
    return compile(arena, doc)?;
}

pub @func compileFile(arena: mem.Arena, source: string, path: string, out_path: string) {
    $chunk: *chunk_mod.Chunk = compileSource(arena, source, path)?;
    return serialize.writeFile(chunk, out_path);
}

# --- registration helpers (Zig root.zig registerStructNames / registerFunctions) ---

@func registerStructNames(em: *state_mod.EmState, doc: *ast.Document) {
    @for (0..list.len(doc.statements)) |si| {
        $s: *nodes.Node = @as(*nodes.Node, list.get(doc.statements, si));
        @switch (s.kind) {
            common.NodeKind.StructDecl => {
                $sd: *nodes.StructDecl = @as(*nodes.StructDecl, s);
                registerStructDef(em, sd)?;
            }
            common.NodeKind.EnumDecl => {
                $ed: *nodes.EnumDecl = @as(*nodes.EnumDecl, s);
                $vNames = list.create(em.arena);
                $vVals = list.create(em.arena);
                @for (0..list.len(ed.variants)) |vi| {
                    list.push(vNames, list.get(ed.variants, vi));
                    list.push(vVals, vi);
                }
                map.set(em.enums, ed.name, @new(em.arena, state_mod.EmEnumDef {
                    name: ed.name,
                    variant_names: vNames,
                    variant_vals: vVals,
                }));
            }
            common.NodeKind.ErrorDecl => {
                $er: *nodes.ErrorDecl = @as(*nodes.ErrorDecl, s);
                $eNames = list.create(em.arena);
                $eOrigins = list.create(em.arena);
                @for (0..list.len(er.variants)) |ei| {
                    list.push(eNames, list.get(er.variants, ei));
                    list.push(eOrigins, er.name);
                }
                map.set(em.error_sets, er.name, @new(em.arena, state_mod.EmErrorSet {
                    name: er.name,
                    variant_names: eNames,
                    origins: eOrigins,
                }));
            }
            common.NodeKind.TypeDecl => {
                $td: *nodes.TypeDecl = @as(*nodes.TypeDecl, s);
                # Stub so `@struct` fields may mention `*Name` before `@type Name = …`.
                @if (state_mod.emHasTypedef(em, td.name)) {
                    continue;
                }
                @if (state_mod.emHasStruct(em, td.name) || state_mod.emHasEnum(em, td.name) || state_mod.emHasErrorSet(em, td.name)) {
                    continue;
                }
                map.set(em.typedefs, td.name, @new(em.arena, state_mod.EmTypedef {
                    name: td.name,
                    underlying: "",
                    distinct: td.distinct,
                    stub: true,
                }));
            }
            @else => {}
        }
    }
}

# Struct layout + method registration (Zig decl.compileStruct runs this in
# registerStructNames-equivalent phase; methods qualify to Struct::method).
@func registerStructDef(em: *state_mod.EmState, sd: *nodes.StructDecl) {
    $field_list = list.create(em.arena);
    @for (0..list.len(sd.fields)) |fi| {
        $field: *nodes.StructField = @as(*nodes.StructField, list.get(sd.fields, fi));
        $disp: string = "int";
        @if (field.type_annotation != null) {
            $d = typecheck.typeAstToDisplay(em, @as(*nodes.Node, field.type_annotation));
            @if (d != null) {
                disp = @as(string, d);
            } @else {
                disp = "unknown";
            }
        }
        list.push(field_list, @new(em.arena, layout.FieldSpec { name: field.name, type_name: disp }));
    }
    $laid = layout.layoutFields(field_list, em.arena);
    $def = @new(em.arena, state_mod.EmStructDef {
        name: sd.name,
        size: laid.size,
        field_names: list.create(em.arena),
        field_offsets: laid.offsets,
        field_types: list.create(em.arena),
        field_kinds: list.create(em.arena),
    });
    @for (0..list.len(field_list)) |gi| {
        $fs: *layout.FieldSpec = @as(*layout.FieldSpec, list.get(field_list, gi));
        list.push(def.field_names, fs.name);
        list.push(def.field_types, fs.type_name);
        list.push(def.field_kinds, layout.fieldKind(em, fs.type_name));
    }
    map.set(em.structs, sd.name, def);

    # Qualify method names to Struct::method for dispatch
    @for (0..list.len(sd.methods)) |mi| {
        $m: *nodes.Node = @as(*nodes.Node, list.get(sd.methods, mi));
        @if (m.kind != common.NodeKind.FunctionDecl) {
            continue;
        }
        $mf: *nodes.FunctionDecl = @as(*nodes.FunctionDecl, m);
        @if (string.contains(mf.name, "::") == false) {
            mf.name = string.concat(string.concat(sd.name, "::"), mf.name);
        }
    }
}

@func registerFunctions(em: *state_mod.EmState, doc: *ast.Document) {
    @for (0..list.len(doc.statements)) |si| {
        $s: *nodes.Node = @as(*nodes.Node, list.get(doc.statements, si));
        collectFuncs(em, s, "")?;
    }
    refineErrorReturns(em)?;
}

@func collectFuncs(em: *state_mod.EmState, node: *nodes.Node, struct_name: string) {
    @if (node.kind == common.NodeKind.FunctionDecl) {
        $fd: *nodes.FunctionDecl = @as(*nodes.FunctionDecl, node);
        @if (string.len(struct_name) > 0) {
            @if (string.contains(fd.name, "::") == false) {
                fd.name = string.concat(string.concat(struct_name, "::"), fd.name);
            }
        }
        $return_type: ?string = null;
        @if (fd.return_type != null) {
            $d = typecheck.typeAstToDisplay(em, @as(*nodes.Node, fd.return_type));
            @if (d != null) {
                return_type = @as(string, d);
            }
        }
        $arity: i64 = 0;
        @if (fd.params.kind == common.NodeKind.Params) {
            $ps: *nodes.Params = @as(*nodes.Params, fd.params);
            arity = list.len(ps.params);
        }
        list.push(em.functions, @new(em.arena, state_mod.EmFunc {
            name: fd.name,
            node: node,
            address: -1,
            arity: arity,
            return_type: return_type,
            is_public: fd.is_public,
            patches: list.create(em.arena),
        }));
        return;
    }
    @if (node.kind == common.NodeKind.StructDecl) {
        $sd2: *nodes.StructDecl = @as(*nodes.StructDecl, node);
        @for (0..list.len(sd2.methods)) |mi| {
            collectFuncs(em, @as(*nodes.Node, list.get(sd2.methods, mi)), sd2.name)?;
        }
        return;
    }
}

# Widen return types when any return path is `error(...)` or a call that already
# returns an error-union (Zig root.zig refineErrorReturns, fixpoint).
@func refineErrorReturns(em: *state_mod.EmState) {
    return;
    # Fixpoint: 64 rounds is far beyond any real return-type chain.
    @for (0..64) {
        $changed = false;
        @for (0..list.len(em.functions)) |fi| {
            $def: *state_mod.EmFunc = @as(*state_mod.EmFunc, list.get(em.functions, fi));
            @if (def.node.kind != common.NodeKind.FunctionDecl) {
                continue;
            }
            $carries = list.create(em.arena);
            list.push(carries, false);
            scanReturnsForError(em, @as(*nodes.Node, @as(*nodes.FunctionDecl, def.node).body), carries)?;
            @if (list.get(carries, 0) == false) {
                continue;
            }
            @if (def.return_type == null) {
                # Always keep a success arm when unannotated — pure `error` breaks
                # `T = f()?` before the success type is refined.
                def.return_type = "unknown | error";
                changed = true;
            } @else {
                $t: string = @as(string, def.return_type);
                @if (typeAllowsError(t) == false) {
                    def.return_type = string.concat(t, " | error");
                    changed = true;
                }
            }
        }
        @if (changed == false) {
            break;
        }
    }
}

@func scanReturnsForError(em: *state_mod.EmState, node: *nodes.Node, carries) {
    @if (node.kind == common.NodeKind.Return) {
        $r: *nodes.Return = @as(*nodes.Return, node);
        @if (r.return_value != null) {
            $v: *nodes.Node = @as(*nodes.Node, r.return_value);
            @if (v.kind == common.NodeKind.ErrorExpr) {
                list.set(carries, 0, true);
            }
            @if (v.kind == common.NodeKind.Call) {
                $c: *nodes.Call = @as(*nodes.Call, v);
                @if (calleeReturnType(em, c.callee) != null) {
                    $rt: string = @as(string, calleeReturnType(em, c.callee));
                    @if (typeAllowsError(rt)) {
                        list.set(carries, 0, true);
                    }
                }
            }
            scanReturnsForError(em, v, carries)?;
        }
        return;
    }
    # `expr?` propagates error to the caller — same as an error return path.
    @if (node.kind == common.NodeKind.TryExpr) {
        $t: *nodes.TryExpr = @as(*nodes.TryExpr, node);
        list.set(carries, 0, true);
        scanReturnsForError(em, t.expression, carries)?;
        return;
    }
    @if (node.kind == common.NodeKind.Declaration) {
        $d: *nodes.Declaration = @as(*nodes.Declaration, node);
        scanReturnsForError(em, d.value, carries)?;
        return;
    }
    @if (node.kind == common.NodeKind.Block) {
        $b: *nodes.Block = @as(*nodes.Block, node);
        @for (0..list.len(b.statements)) |si| {
            scanReturnsForError(em, @as(*nodes.Node, list.get(b.statements, si)), carries)?;
        }
        return;
    }
    @if (node.kind == common.NodeKind.If) {
        $i: *nodes.If = @as(*nodes.If, node);
        scanReturnsForError(em, i.condition, carries)?;
        scanReturnsForError(em, i.body, carries)?;
        @if (i.else_body != null) {
            scanReturnsForError(em, @as(*nodes.Node, i.else_body), carries)?;
        }
        return;
    }
    @if (node.kind == common.NodeKind.Switch) {
        $sw: *nodes.Switch = @as(*nodes.Switch, node);
        scanReturnsForError(em, sw.condition, carries)?;
        @for (0..list.len(sw.prongs)) |pi| {
            $prong: *nodes.SwitchProng = @as(*nodes.SwitchProng, list.get(sw.prongs, pi));
            @for (0..list.len(prong.patterns)) |qi| {
                scanReturnsForError(em, @as(*nodes.Node, list.get(prong.patterns, qi)), carries)?;
            }
            scanReturnsForError(em, prong.body, carries)?;
        }
        return;
    }
    @if (node.kind == common.NodeKind.For) {
        $f: *nodes.For = @as(*nodes.For, node);
        scanReturnsForError(em, f.expr, carries)?;
        scanReturnsForError(em, f.body, carries)?;
        return;
    }
    @if (node.kind == common.NodeKind.Call) {
        $c2: *nodes.Call = @as(*nodes.Call, node);
        scanReturnsForError(em, c2.callee, carries)?;
        @for (0..list.len(c2.args)) |ai| {
            scanReturnsForError(em, @as(*nodes.Node, list.get(c2.args, ai)), carries)?;
        }
        return;
    }
    @if (node.kind == common.NodeKind.Binary) {
        $bin: *nodes.Binary = @as(*nodes.Binary, node);
        scanReturnsForError(em, bin.left, carries)?;
        scanReturnsForError(em, bin.right, carries)?;
        return;
    }
    @if (node.kind == common.NodeKind.Unary) {
        $u: *nodes.Unary = @as(*nodes.Unary, node);
        scanReturnsForError(em, u.arg, carries)?;
        return;
    }
    @if (node.kind == common.NodeKind.Assignment) {
        $a: *nodes.Assignment = @as(*nodes.Assignment, node);
        scanReturnsForError(em, a.left, carries)?;
        scanReturnsForError(em, a.right, carries)?;
        return;
    }
    @if (node.kind == common.NodeKind.Defer) {
        $df: *nodes.Defer = @as(*nodes.Defer, node);
        scanReturnsForError(em, df.body, carries)?;
        return;
    }
    @if (node.kind == common.NodeKind.Break) {
        $br: *nodes.Break = @as(*nodes.Break, node);
        @if (br.value != null) {
            scanReturnsForError(em, @as(*nodes.Node, br.value), carries)?;
        }
        return;
    }
}

@func calleeReturnType(em: *state_mod.EmState, callee: *nodes.Node) {
    @if (callee.kind == common.NodeKind.Primary) {
        $p: *nodes.Primary = @as(*nodes.Primary, callee);
        @if (p.primary_kind == nodes.PrimaryKind.Identifier) {
            $def = state_mod.emFindFunc(em, p.name);
            @if (def != null) {
                return @as(*state_mod.EmFunc, def).return_type;
            }
        }
    }
    @if (callee.kind == common.NodeKind.Member) {
        $m: *nodes.Member = @as(*nodes.Member, callee);
        @if (m.property.kind == common.NodeKind.Primary) {
            $prop: *nodes.Primary = @as(*nodes.Primary, m.property);
            $obj_type = typecheck.resolveType(em, m.object);
            @if (obj_type != null) {
                $tn: string = @as(string, obj_type);
                $method_name = string.concat(string.concat(typecheck.unwrapOptionalDisplay(tn), "::"), prop.name);
                $def2 = state_mod.emFindFunc(em, method_name);
                @if (def2 != null) {
                    return @as(*state_mod.EmFunc, def2).return_type;
                }
            }
        }
    }
    return null;
}

@func typeAllowsError(t: string): bool {
    @if (string.eql(t, "error")) {
        return true;
    }
    @if (string.endsWith(t, " | error")) {
        return true;
    }
    @if (string.startsWith(t, "error | ")) {
        return true;
    }
    @if (string.contains(t, " | error | ")) {
        return true;
    }
    return false;
}

@func registerModuleDecls(em: *state_mod.EmState, doc: *ast.Document) {
    @for (0..list.len(doc.statements)) |si| {
        $s: *nodes.Node = @as(*nodes.Node, list.get(doc.statements, si));
        @if (s.kind == common.NodeKind.Declaration) {
            $d: *nodes.Declaration = @as(*nodes.Declaration, s);
            @if (map.has(em.global_vars, d.name)) {
                return error("CompileError", string.concat("Variable '", string.concat(d.name, "' already declared in this scope")));
            }
            map.set(em.global_vars, d.name, true);
            @if (d.is_const) {
                map.set(em.global_consts, d.name, true);
            }
        }
    }
}
