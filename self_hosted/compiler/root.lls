        return error("EmitUnsupported", "range capture");
    }
    $emCap0: *nodes.Capture = @as(*nodes.Capture, list.get(fe.captures, 0));

    emExpr(em, emRBin.left)?;
    $emIIndex = emPushLocal(em, emCap0.name);

    emExpr(em, emRBin.right)?;
    $emEndIndex = emPushLocal(em, ".range_end");

    em.chunk.writeOp(opcode.OpCode.OP_FOR_PREP);
    em.chunk.writeByte(@as(u8, emIIndex));
    em.chunk.writeByte(@as(u8, emEndIndex));
    $emPrepSkip = em.chunk.codeLen();
    em.chunk.writeByte(255);
    em.chunk.writeByte(255);

    $emBodyStart = em.chunk.codeLen();
    emBeginScope(em);
    @if (fe.body.kind != common.NodeKind.Block) {
        return error("EmitUnsupported", "for body");
    }
    $emForBody: *nodes.Block = @as(*nodes.Block, fe.body);
    @for (0..list.len(emForBody.statements)) |emSi2| {
        emStatement(em, @as(*nodes.Node, list.get(emForBody.statements, emSi2)))?;
    }
    emEndScope(em);

    $emLoop: *EmLoop = @as(*EmLoop, list.pop(em.loops));
    @for (0..list.len(emLoop.continue_jumps)) |emCj| {
        em.chunk.patchJump(list.get(emLoop.continue_jumps, emCj));
    }

    em.chunk.writeOp(opcode.OpCode.OP_FOR_LOOP);
    em.chunk.writeByte(@as(u8, emIIndex));
    em.chunk.writeByte(@as(u8, emEndIndex));
    $emAfterOp = em.chunk.codeLen() + 2;
    $emBack = emAfterOp - emBodyStart;
    em.chunk.writeByte(@as(u8, (emBack >> 8) & 255));
    em.chunk.writeByte(@as(u8, emBack & 255));

    $emSkip = em.chunk.codeLen() - emPrepSkip - 2;
    em.chunk.setByte(emPrepSkip, @as(u8, (emSkip >> 8) & 255));
    em.chunk.setByte(emPrepSkip + 1, @as(u8, emSkip & 255));

    @for (0..list.len(emLoop.break_jumps)) |emBj| {
        em.chunk.patchJump(list.get(emLoop.break_jumps, emBj));
    }
}

@func emFor(em: *EmState, fe: *nodes.For) {
    emBeginScope(em);
    @if (fe.label != null) {
        $emForLab: string = @as(string, fe.label);
        list.push(em.loops, @new(em.arena, EmLoop {
            scope_depth: em.scope_depth,
            label: emForLab,
            break_jumps: list.create(em.arena),
            continue_jumps: list.create(em.arena),
        }));
    } @else {
        list.push(em.loops, @new(em.arena, EmLoop {
            scope_depth: em.scope_depth,
            label: "",
            break_jumps: list.create(em.arena),
            continue_jumps: list.create(em.arena),
        }));
    }

    @if (fe.expr.kind == common.NodeKind.Binary) {
        $emChk: *nodes.Binary = @as(*nodes.Binary, fe.expr);
        @if (string.eql(emChk.operator, "..")) {
            emRangeFor(em, fe)?;
            emEndScope(em);
            return;
        }
    }

    $emLoopStart = em.chunk.codeLen();
    $emHasExit = false;
    $emExitJ = 0;
    $emIsInf = false;
    @if (fe.expr.kind == common.NodeKind.Literal) {
        $emLit: *nodes.Literal = @as(*nodes.Literal, fe.expr);
        @if (string.eql(emLit.value, "true")) {
            emIsInf = true;
        }
    }
    @if (emIsInf == false) {
        emExpr(em, fe.expr)?;
        emExitJ = em.chunk.emitJump(opcode.OpCode.OP_JUMP_IF_FALSE);
        emHasExit = true;
        @if (list.len(fe.captures) == 0) {
            em.chunk.writeOp(opcode.OpCode.OP_POP);
        }
    }
    emBeginScope(em);
    @if (list.len(fe.captures) > 0) {
        $emC0: *nodes.Capture = @as(*nodes.Capture, list.get(fe.captures, 0));
        _ = emPushLocal(em, emC0.name);
    }
    @if (fe.body.kind != common.NodeKind.Block) {
        return error("EmitUnsupported", "for body");
    }
    $emCondBody: *nodes.Block = @as(*nodes.Block, fe.body);
    @for (0..list.len(emCondBody.statements)) |emSi3| {
        emStatement(em, @as(*nodes.Node, list.get(emCondBody.statements, emSi3)))?;
    }
    emEndScope(em);

    $emLoop2: *EmLoop = @as(*EmLoop, list.pop(em.loops));
    @for (0..list.len(emLoop2.continue_jumps)) |emCj2| {
        em.chunk.patchJump(list.get(emLoop2.continue_jumps, emCj2));
    }
    em.chunk.emitLoop(emLoopStart);
    @if (emHasExit) {
        em.chunk.patchJump(emExitJ);
        em.chunk.writeOp(opcode.OpCode.OP_POP);
    }
    @for (0..list.len(emLoop2.break_jumps)) |emBj2| {
        em.chunk.patchJump(list.get(emLoop2.break_jumps, emBj2));
    }
    emEndScope(em);
}

@func emBlock(em: *EmState, b: *nodes.Block) {
    emBeginScope(em);
    @for (0..list.len(b.statements)) |emSi4| {
        emStatement(em, @as(*nodes.Node, list.get(b.statements, emSi4)))?;
    }
    emEndScope(em);
}

@func emFunctionBody(em: *EmState, fd: *nodes.FunctionDecl) {
    $emOuterLocals = em.locals;
    $emOuterDepth = em.scope_depth;
    em.locals = list.create(em.arena);
    em.scope_depth = 0;

    emBeginScope(em);
    @if (fd.params.kind != common.NodeKind.Params) {
        return error("EmitUnsupported", "params");
    }
    $emParams: *nodes.Params = @as(*nodes.Params, fd.params);
    @for (0..list.len(emParams.params)) |emPi| {
        $emParam: *nodes.Param = @as(*nodes.Param, list.get(emParams.params, emPi));
        @if (emParam.type_annotation != null) {
            $emPty = emTypeDisplay(emParam.type_annotation);
            _ = emPushLocalTyped(em, emParam.name, emPty);
        } @else {
            _ = emPushLocal(em, emParam.name);
            @if (string.eql(emParam.name, "self")) {
                $emColon = string.indexOf(fd.name, "::");
                @if (emColon >= 0) {
                    $emSName = string.slice(fd.name, 0, emColon);
                    emSetVarType(em, "self", emSName);
                    $emSelfLoc: *EmLocal = @as(*EmLocal, list.get(em.locals, list.len(em.locals) - 1));
                    emSelfLoc.type_name = emSName;
                }
            }
        }
    }

    @if (fd.body.kind != common.NodeKind.Block) {
        return error("EmitUnsupported", "func body");
    }
    $emFnBody: *nodes.Block = @as(*nodes.Block, fd.body);
    @for (0..list.len(emFnBody.statements)) |emSi5| {
        emStatement(em, @as(*nodes.Node, list.get(emFnBody.statements, emSi5)))?;
    }

    em.chunk.writeOp(opcode.OpCode.OP_NULL);
    em.chunk.writeOp(opcode.OpCode.OP_RETURN);

    em.locals = emOuterLocals;
    em.scope_depth = emOuterDepth;
}

@func emStatement(em: *EmState, n: *nodes.Node) {
    @if (n.kind == common.NodeKind.FunctionDecl) {
        return;
    }
    @if (n.kind == common.NodeKind.StructDecl) {
        return;
    }
    @if (n.kind == common.NodeKind.EnumDecl) {
        return;
    }
    @if (n.kind == common.NodeKind.ErrorDecl) {
        return;
    }
    @if (n.kind == common.NodeKind.TypeDecl) {
        return;
    }
    @if (n.kind == common.NodeKind.Extern) {
        return;
    }
    @if (n.kind == common.NodeKind.Declaration) {
        emDeclaration(em, @as(*nodes.Declaration, n))?;
        return;
    }
    @if (n.kind == common.NodeKind.Return) {
        emReturn(em, @as(*nodes.Return, n))?;
        return;
    }
    @if (n.kind == common.NodeKind.If) {
        emIf(em, @as(*nodes.If, n))?;
        return;
    }
    @if (n.kind == common.NodeKind.For) {
        emFor(em, @as(*nodes.For, n))?;
        return;
    }
    @if (n.kind == common.NodeKind.Break) {
        emBreak(em, @as(*nodes.Break, n))?;
        return;
    }
    @if (n.kind == common.NodeKind.Continue) {
        emContinue(em, @as(*nodes.Continue, n))?;
        return;
    }
    @if (n.kind == common.NodeKind.Block) {
        emBlock(em, @as(*nodes.Block, n))?;
        return;
    }
    emExpr(em, n)?;
    em.chunk.writeOp(opcode.OpCode.OP_POP);
}

@func emFnArity(n: *nodes.Node) {
    $emFd: *nodes.FunctionDecl = @as(*nodes.FunctionDecl, n);
    @if (emFd.params.kind != common.NodeKind.Params) {
        return 0;
    }
    $emPs: *nodes.Params = @as(*nodes.Params, emFd.params);
    return list.len(emPs.params);
}

@func emCollectFunctions(em: *EmState, doc: *ast.Document) {
    @for (0..list.len(doc.statements)) |emDi| {
        $emStmt: *nodes.Node = @as(*nodes.Node, list.get(doc.statements, emDi));
        @if (emStmt.kind == common.NodeKind.FunctionDecl) {
            $emFd2: *nodes.FunctionDecl = @as(*nodes.FunctionDecl, emStmt);
            list.push(em.functions, @new(em.arena, EmFunc {
                name: emFd2.name,
                node: emStmt,
                address: -1,
                arity: emFnArity(emStmt),
                patches: list.create(em.arena),
            }));
        }
    }
}

@func emEmitAllFunctions(em: *EmState) {
    @for (0..list.len(em.functions)) |emFi2| {
        $emFn5: *EmFunc = @as(*EmFunc, list.get(em.functions, emFi2));
        emFn5.address = em.chunk.codeLen();
        @for (0..list.len(emFn5.patches)) |emPi2| {
            $emPatch2 = list.get(emFn5.patches, emPi2);
            em.chunk.setByte(emPatch2, @as(u8, (emFn5.address >> 8) & 255));
            em.chunk.setByte(emPatch2 + 1, @as(u8, emFn5.address & 255));
        }
        em.chunk.addFunction(emFn5.name, emFn5.address, emFn5.arity);
        emFunctionBody(em, @as(*nodes.FunctionDecl, emFn5.node))?;
    }
}

pub @func compileSource(arena: mem.Arena, source: string, path: string) {
    $emParsed = parser.parse(arena, source, path);
    @if (@isError(emParsed)) {
        return emParsed;
    }
    $emDoc: *ast.Document = @as(*ast.Document, emParsed);
    $em = emCreateState(arena, path);
    emRegisterStructs(em, emDoc);
    emRegisterEnums(em, emDoc);
    emCollectFunctions(em, emDoc);

    $emMainJump = em.chunk.emitJump(opcode.OpCode.OP_JUMP);
    emEmitAllFunctions(em)?;
    em.chunk.patchJump(emMainJump);

    @for (0..list.len(emDoc.statements)) |emDi2| {
        $emTop: *nodes.Node = @as(*nodes.Node, list.get(emDoc.statements, emDi2));
        @if (emTop.kind != common.NodeKind.FunctionDecl) {
            emStatement(em, emTop)?;
        }
    }

    $emMaino = emFindFunc(em, "main");
    @if (emMaino != null) {
        $emMain: *EmFunc = @as(*EmFunc, emMaino);
        @if (emMain.address < 0) {
            return error("Emit", "main has no address");
        }
        em.chunk.emitCallStatic(emMain.address, 0);
        em.chunk.writeOp(opcode.OpCode.OP_POP);
    }

    em.chunk.writeOp(opcode.OpCode.OP_NULL);
    em.chunk.writeOp(opcode.OpCode.OP_RETURN);
    return em.chunk;
}

pub @func compileFile(arena: mem.Arena, source: string, path: string, out_path: string) {
    $emChunk: *chunk_mod.Chunk = compileSource(arena, source, path)?;
    return serialize.writeFile(emChunk, out_path);
}
