            return;
        }
        @if (string.eql(emCal.name, "len")) {
            em.chunk.emitGetGlobal("len");
            $emArgcL = list.len(call.args);
            @for (0..emArgcL) |emAiL| {
                emExpr(em, @as(*nodes.Node, list.get(call.args, emAiL)))?;
            }
            em.chunk.writeOp(opcode.OpCode.OP_CALL);
            em.chunk.writeByte(@as(u8, emArgcL));
