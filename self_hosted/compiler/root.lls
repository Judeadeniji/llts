        $emElseJ = em.chunk.emitJump(opcode.OpCode.OP_JUMP);
        em.chunk.patchJump(emThenJ);
        em.chunk.writeOp(opcode.OpCode.OP_POP);
        @if (emElseN.kind == common.NodeKind.Block) {
            emBeginScope(em);
            $emElseBody: *nodes.Block = @as(*nodes.Block, emElseN);
            @for (0..list.len(emElseBody.statements)) |emEsi| {
                emStatement(em, @as(*nodes.Node, list.get(emElseBody.statements, emEsi)))?;
            }
            emEndScope(em);
        } @else {
            @if (emElseN.kind == common.NodeKind.If) {
                emIf(em, @as(*nodes.If, emElseN))?;
            } @else {
                return error("EmitUnsupported", "else body");
            }
