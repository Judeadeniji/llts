@func emIsImportDecl(d: *nodes.Declaration) {
    @if (d.value.kind != common.NodeKind.Call) {
        return false;
    }
    $emImpCall: *nodes.Call = @as(*nodes.Call, d.value);
    @if (emImpCall.callee.kind != common.NodeKind.Primary) {
        return false;
    }
    $emImpCal: *nodes.Primary = @as(*nodes.Primary, emImpCall.callee);
    return string.eql(emImpCal.name, "@import");
}

@func emDeclaration(em: *EmState, d: *nodes.Declaration) {
    @if (emIsImportDecl(d)) {
        return;
    }
    emExpr(em, d.value)?;
    @if (d.type_annotation != null) {
        $emDeclTyA = emTypeDisplay(d.type_annotation);
        @if (em.scope_depth > 0) {
            _ = emPushLocalTyped(em, d.name, emDeclTyA);
        } @else {
            em.chunk.emitSetGlobal(d.name);
            em.chunk.writeOp(opcode.OpCode.OP_POP);
