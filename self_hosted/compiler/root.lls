    } @else {
        em.chunk.emitSetGlobal(d.name);
        em.chunk.writeOp(opcode.OpCode.OP_POP);
    }
}

@func emReturn(em: *EmState, r: *nodes.Return) {
    @if (r.return_value != null) {
        emExpr(em, @as(*nodes.Node, r.return_value))?;
    } @else {
        em.chunk.writeOp(opcode.OpCode.OP_NULL);
    }
    em.chunk.writeOp(opcode.OpCode.OP_RETURN);
}

@func emIf(em: *EmState, ife: *nodes.If) {
    emExpr(em, ife.condition)?;
    $emThenJ = em.chunk.emitJump(opcode.OpCode.OP_JUMP_IF_FALSE);

    emBeginScope(em);
    @if (ife.pipe_value != null) {
