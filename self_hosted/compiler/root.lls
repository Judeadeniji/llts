        $emSkipPop = em.chunk.emitJump(opcode.OpCode.OP_JUMP);
        em.chunk.patchJump(emThenJ);
        em.chunk.writeOp(opcode.OpCode.OP_POP);
        em.chunk.patchJump(emSkipPop);
    }
}

@func emFindLoop(em: *EmState, want: ?string): ?*EmLoop {
    $emLi = list.len(em.loops) - 1;
    @for (true) {
        @if (emLi < 0) {
            return null;
        }
        $emLp: *EmLoop = @as(*EmLoop, list.get(em.loops, emLi));
        @if (want == null) {
            return emLp;
        }
        $emWant: string = @as(string, want);
        @if (string.len(emLp.label) > 0) {
            @if (string.eql(emLp.label, emWant)) {
                return emLp;
            }
        }
        emLi = emLi - 1;
    }
    return null;
}

@func emBreak(em: *EmState, brk: *nodes.Break) {
    @if (brk.value != null) {
