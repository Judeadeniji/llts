# Port of src/ast/root.zig — Document + re-exports.

@const $common = @import("./common.lls");
@const $nodes = @import("./nodes.lls");
@const $mem = @import("std/mem.lls");
@const $list = @import("std/list.lls");

# Re-export for the parser port (same module object; arm types live on `nodes`).
pub @const $expr = nodes;
pub @const $stmt = nodes;
pub @const $types = nodes;

pub @struct Document {
    path: string;
    source: string;
    statements: unknown;
    arena: mem.Arena;
}

pub @func createDocument(arena: mem.Arena, path: string, source: string): *Document {
    return @new(arena, Document {
        path: path,
        source: source,
        statements: list.create(arena),
        arena: arena,
    });
}
