# Port of src/ast/stmt.zig

@const $common = @import("./common.lls");

pub @struct Declaration {
    kind: common.NodeKind.Declaration;
    name: string;
    value: unknown;
    is_const: bool;
    is_public: bool;
    type_annotation: unknown;
    loc: common.Location;
}

pub @struct Param {
    name: string;
    type_annotation: unknown;
    is_rest: bool;
    loc: common.Location;
}

pub @struct Params {
    kind: common.NodeKind.Params;
    params: unknown;
    is_variadic: bool;
    loc: common.Location;
}

pub @struct FunctionDecl {
    kind: common.NodeKind.FunctionDecl;
    name: string;
    params: unknown;
    body: unknown;
    return_type: unknown;
    is_public: bool;
    loc: common.Location;
}

pub @struct Block {
    kind: common.NodeKind.Block;
    statements: unknown;
    label: ?string;
    loc: common.Location;
}

pub @struct Return {
    kind: common.NodeKind.Return;
    return_value: unknown;
    loc: common.Location;
}

pub @struct Defer {
    kind: common.NodeKind.Defer;
    body: unknown;
    is_errdefer: bool;
    loc: common.Location;
}

pub @struct Break {
    kind: common.NodeKind.Break;
    label: ?string;
    value: unknown;
    loc: common.Location;
}

pub @struct Continue {
    kind: common.NodeKind.Continue;
    label: ?string;
    loc: common.Location;
}

pub @struct If {
    kind: common.NodeKind.If;
    condition: unknown;
    pipe_value: unknown;
    body: unknown;
    else_body: unknown;
    label: ?string;
    loc: common.Location;
}

pub @struct Capture {
    name: string;
    by_ref: bool;
}

pub @struct For {
    kind: common.NodeKind.For;
    expr: unknown;
    captures: unknown;
    label: ?string;
    body: unknown;
    loc: common.Location;
}

pub @struct SwitchProng {
    patterns: unknown;
    is_else: bool;
    body: unknown;
    loc: common.Location;
}

pub @struct Switch {
    kind: common.NodeKind.Switch;
    condition: unknown;
    prongs: unknown;
    label: ?string;
    loc: common.Location;
}

pub @struct Extern {
    kind: common.NodeKind.Extern;
    name: string;
    is_public: bool;
    loc: common.Location;
}

pub @struct StructField {
    name: string;
    type_annotation: unknown;
}

pub @struct StructDecl {
    kind: common.NodeKind.StructDecl;
    name: string;
    fields: unknown;
    methods: unknown;
    is_public: bool;
    loc: common.Location;
}

pub @struct EnumDecl {
    kind: common.NodeKind.EnumDecl;
    name: string;
    variants: unknown;
    is_public: bool;
    loc: common.Location;
}

pub @struct TypeDecl {
    kind: common.NodeKind.TypeDecl;
    name: string;
    type_expr: unknown;
    distinct: bool;
    is_public: bool;
    loc: common.Location;
}

pub @struct ErrorDecl {
    kind: common.NodeKind.ErrorDecl;
    name: string;
    variants: unknown;
    is_public: bool;
    loc: common.Location;
}
