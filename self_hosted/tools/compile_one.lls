# Compile one example. Path is read from /tmp/llts_smoke_path.txt
# (os.args() + self-hosted compiler in one program panics the host).

@const $compiler = @import("../compiler/root.lls");
@const $mem = @import("std/mem.lls");
@const $debug = @import("std/debug.lls");
@const $os = @import("std/os.lls");

$path = __readFile("/tmp/llts_smoke_path.txt");
@if (@isError(path)) {
    print(path);
    os.exit(1);
}
$src = __readFile(path);
@if (@isError(src)) {
    print(src);
    os.exit(1);
}
$out = "/tmp/llts_compile_one.llb";
$arena = mem.create(0);
$err = compiler.compileFile(arena, src, path, out);
@if (@isError(err)) {
    print(err);
    os.exit(1);
}
debug.printLn("{s}", out);
arena.deinit();

pub @func main() {}
