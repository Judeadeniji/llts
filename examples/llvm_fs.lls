# LLVM-backend smoke test for filesystem operations.
# Uses std/fs.lls which builds on top of syscall natives.

@const $fs = @import("std/fs");
@const $s = @import("std/string");

pub @func main() {
    # write / read round-trip
    fs.writeFile("llvm_fs_tmp.txt", "abc");
    print(fs.exists("llvm_fs_tmp.txt"));
    print(fs.readFile("llvm_fs_tmp.txt"));

    # stat
    $st = fs.stat("llvm_fs_tmp.txt");
    print("st len: ");

    # rename
    fs.rename("llvm_fs_tmp.txt", "llvm_fs_tmp2.txt");
    print(fs.exists("llvm_fs_tmp.txt"));
    print(fs.exists("llvm_fs_tmp2.txt"));

    # copyFile
    fs.copyFile("llvm_fs_tmp2.txt", "llvm_fs_tmp3.txt");
    print(fs.readFile("llvm_fs_tmp3.txt"));

    # mkdirAll + readDir
    fs.mkdirAll("llvm_fs_dir/sub");
    $entries = fs.readDir("llvm_fs_dir");
    print(len(entries));
    print(entries[0]);

    # realpath
    $rp = fs.realpath("llvm_fs_tmp2.txt");
    print(len(rp) > 0);

    # cleanup
    fs.deleteFile("llvm_fs_tmp2.txt");
    fs.deleteFile("llvm_fs_tmp3.txt");
    fs.deleteFile("llvm_fs_dir/sub");
    fs.deleteFile("llvm_fs_dir");
    print(fs.exists("llvm_fs_tmp2.txt"));
}
