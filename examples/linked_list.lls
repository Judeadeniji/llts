# Singly-linked list as a data structure.
#
# Nodes live on the list's Arena (`@new`). There is no per-node free —
# `defer arena.deinit()` drops the whole chain.
#
#   zig-out/bin/llts run examples/linked_list.lls

@const $mem = @import("std/mem");
@const $debug = @import("std/debug");

@struct Node {
    value: int;
    next: ?Node;
}

@struct LinkedList {
    arena: mem.Arena;
    head: ?Node;

    @func pushFront(self, value: int) {
        self.head = @new(self.arena, Node { value: value, next: self.head });
    }

    @func pushBack(self, value: int) {
        $n = @new(self.arena, Node { value: value, next: null });
        @if (self.head == null) {
            self.head = n;
            return;
        }
        $curr = self.head;
        @for (curr.next != null) {
            curr = curr.next;
        }
        curr.next = n;
    }

    @func len(self) {
        $n = 0;
        $curr = self.head;
        @for (curr != null) {
            n = n + 1;
            curr = curr.next;
        }
        return n;
    }

    @func sum(self) {
        $total = 0;
        $curr = self.head;
        @for (curr != null) {
            total = total + curr.value;
            curr = curr.next;
        }
        return total;
    }

    @func contains(self, value: int) {
        $curr = self.head;
        @for (curr != null) {
            @if (curr.value == value) {
                return true;
            }
            curr = curr.next;
        }
        return false;
    }

    @func reverse(self) {
        $prev: ?Node = null;
        $curr = self.head;
        @for (curr != null) {
            $nxt = curr.next;
            curr.next = prev;
            prev = curr;
            curr = nxt;
        }
        self.head = prev;
    }

    @func print(self) {
        $curr = self.head;
        @for (curr != null) {
            debug.printLn("  {i}", curr.value);
            curr = curr.next;
        }
    }
}

@func create(arena: mem.Arena): LinkedList {
    return @new(arena, LinkedList { arena: arena, head: null });
}

pub @func main() {
    $arena = mem.create(0);
    defer arena.deinit();

    $list = create(arena);

    @for (1..6) |i| {
        list.pushFront(i);
    }

    debug.printLn("after pushFront 1..5 (head is 5):");
    list.print();
    debug.printLn("len = {i}", list.len());
    debug.printLn("sum = {i}", list.sum());
    debug.printLn("contains 3 = {i}", list.contains(3));
    debug.printLn("contains 9 = {i}", list.contains(9));

    list.reverse();
    debug.printLn("after reverse (head is 1):");
    list.print();

    list.pushBack(6);
    debug.printLn("after pushBack 6:");
    list.print();
    debug.printLn("sum = {i}", list.sum());
}
