# Singly-linked list as a data structure.
#
# Nodes live on the list's Arena (`@new`). There is no per-node free —
# `defer arena.deinit()` drops the whole chain.
#
#   zig-out/bin/llts run examples/linked_list.lls

@const $mem = @import("std/mem");
@const $fmt = @import("std/fmt");

@struct Node {
    value: i64;
    next: ?*Node;
}

@struct LinkedList {
    arena: mem.Arena;
    head: ?*Node;

    @func pushFront(self: *LinkedList, value: i64) {
        self.head = @new(self.arena, Node { value: value, next: self.head });
    }

    @func pushBack(self: *LinkedList, value: i64) {
        $n = @new(self.arena, Node { value: value, next: null });
        @if (self.head == null) {
            self.head = n;
            return;
        }
        $curr = self.head;
        @for (curr.next != null) {
            curr = curr.next;
        }
        curr.next = n;
    }

    @func len(self: *LinkedList) {
        $n = 0;
        $curr = self.head;
        @for (curr != null) {
            n = n + 1;
            curr = curr.next;
        }
        return n;
    }

    @func sum(self: *LinkedList) {
        $total = 0;
        $curr = self.head;
        @for (curr != null) {
            total = total + curr.value;
            curr = curr.next;
        }
        return total;
    }

    @func contains(self: *LinkedList, value: i64) {
        $curr = self.head;
        @for (curr != null) {
            @if (curr.value == value) {
                return true;
            }
            curr = curr.next;
        }
        return false;
    }

    @func reverse(self: *LinkedList) {
        $prev: ?*Node = null;
        $curr = self.head;
        @for (curr != null) {
            $nxt = curr.next;
            curr.next = prev;
            prev = curr;
            curr = nxt;
        }
        self.head = prev;
    }

    @func print(self: *LinkedList) {
        $curr = self.head;
        @for (curr != null) {
            fmt.printf("  %d\n", curr.value);
            curr = curr.next;
        }
    }
}

@func create(arena: mem.Arena): *LinkedList {
    return @new(arena, LinkedList { arena: arena, head: null });
}

pub @func main() {
    $arena = mem.create(0);
    defer arena.deinit();

    $list = create(arena);

    @for (1..6) |i| {
        list.pushFront(i);
    }

    fmt.println("after pushFront 1..5 (head is 5):");
    list.print();
    fmt.printf("len = %d\n", list.len());
    fmt.printf("sum = %d\n", list.sum());
    fmt.printf("contains 3 = %v\n", list.contains(3));
    fmt.printf("contains 9 = %v\n", list.contains(9));

    list.reverse();
    fmt.println("after reverse (head is 1):");
    list.print();

    list.pushBack(6);
    fmt.println("after pushBack 6:");
    list.print();
    fmt.printf("sum = %d\n", list.sum());
}
