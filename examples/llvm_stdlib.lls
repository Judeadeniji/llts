@const $string = @import("std/string");
@const $math = @import("std/math");

print(string.len("hello"));
print(string.toUpper("hello"));
print(string.toLower("WORLD"));
print(string.trim("  hi  "));
print(string.concat("foo", "bar"));
print(string.repeat("ab", 3));
print(string.startsWith("hello", "he"));
print(string.endsWith("hello", "lo"));
print(string.contains("hello", "ell"));
print(string.indexOf("hello", "l"));
print(string.lastIndexOf("hello", "l"));
print(string.replace("foo bar foo", "foo", "baz"));
print(string.replaceFirst("foo bar foo", "foo", "baz"));
print(string.substr("hello world", 6, 5));
print(string.slice("hello world", -5, 11));
print(string.padStart("7", 3, "0"));
print(string.padEnd("7", 3, "0"));
print(string.isEmpty(""));
print(string.isBlank("   "));
print(string.compare("a", "b"));
print(string.eql("abc", "abc"));
print(string.parseInt("42", 10));
print(string.parseFloat("3.5"));
print(string.fromCharCode(65));
print(string.charCodeAt("ABC", 1));

$a = string.split("a-b-c", "-");
print(len(a));
print(a[0]);
print(a[1]);
print(a[2]);
$b = string.splitMax("a-b-c-d", "-", 3);
print(len(b));
print(b[0]);
print(b[1]);
print(b[2]);
print(string.join(a, "+"));

print(math.min(10, 5));
print(math.max(10, 5));
print(math.min(3, 1, 4, 1, 5));
print(math.max(3, 1, 4, 1, 5));
print(math.abs(-10));
print(math.floor(5.9));
print(math.ceil(5.1));
print(math.round(5.5));
print(math.pow(2, 10));
print(math.sqrt(64));
$r = math.sqrt(-4);
print(@isError(r));
print(math.floor(math.PI * 100));
print(math.floor(math.E * 100));
print(math.sign(-7));

pub @func main() {
}
