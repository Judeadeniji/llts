@const $std = @import("std/index");

@struct Point {
    x: int;
    y: int;
}

@struct Rect {
    point: Point;
    width: int;
    height: int;
    name: string; # String pointer/value
}

$r = Rect { 
    point: Point { x: 5, y: 10 }, 
    width: 100, 
    height: 200,
    name: "My Awesome Rect"
};

std.debug.printLn("Rect Name: {s}", r.name);
std.debug.printLn("Width: {i}", r.width);
std.debug.printLn("X: {i}", r.point.x);
std.debug.printLn("Y: {i}", r.point.y);

std.debug.assert(r.point.x == 5);
std.debug.assert(r.point.y == 10);
std.debug.assert(r.width == 100);
std.debug.assert(r.name == "My Awesome Rect");
std.debug.assert(r.name != "My Bad Rect");

r.point.x = 99;
std.debug.assert(r.point.x == 99);
