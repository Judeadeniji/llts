# Slice views: arr[i..j], arr[i..], arr[..j], arr[..] (exclusive end).
# Works on strings and []byte / [N]byte. Views are not assignable.
#
#   zig-out/bin/llts run examples/slices.lls

@const $mem = @import("std/mem");

# --- strings ---
$s = "hello";
print(s[1..4]);
print(s[1..]);
print(s[..3]);
print(s[..]);
print(len(s[2..]));

# --- []byte via arena ---
$a = mem.create(0);
defer a.deinit();

$buf = @new(a, [5]byte);
buf[0] = 10;
buf[1] = 20;
buf[2] = 30;
buf[3] = 40;
buf[4] = 50;

$mid = buf[1..4];
print(len(mid));
print(mid[0]);
print(mid[2]);
print(@typeOf(mid));

$tail = buf[2..];
$head = buf[..3];
$all = buf[..];
print(len(tail));
print(tail[0]);
print(len(head));
print(head[2]);
print(len(all));

pub @func main() {}
