@const $std = @import("std/index");

@func add(x: i32, y: i32): i32 {
    return x + y;
}

# Returns `add` as a first-class function value
@func getAdder(n: i32) {
    return add;
}

@struct Builder {
    value: int;

    @func build(self) {
        self.value = self.value + 1;
        return self;
    }

    @func run(self) {
        std.debug.printLn("builder result = {i}", self.value);
        return self.value;
    }
}

@func factory() {
    return Builder { value: 10 };
}

@struct Iter {
    value: int;

    @func next(self) {
        return add;
    }
}

@func get() {
    return Iter { value: 0 };
}

# literals + registers
@const $msg = "Hello, LLTS!";
$a = 10;
$b = 20;
$c = 3;

# basic binary ops
$d = a + b;
$e = a * b + c;
$f = a + b * c;
$g = (a + b) * c;

# unary ops
$h = -a;
$i = !b;

# chained binary ops
$j = 1 + a + b + c;
$k = a * b / c % 2;

# assignment expressions
$l = a = b = c + 1;

$add = std.math.add;

# function calls
$m = add(a, b);
$n = add(1, add(a, b));

# member access
$o = std.debug;
$p = std.debug.printLn;

# call + member chaining
$q = std.debug.printLn("sum = {i}", a + b);
$r = std.debug.printLn("calc = {i}", add(a, b) * c);

# currying / call chaining: getAdder returns `add` as a first-class function
$s = getAdder(1)(2, 3);

# method chaining: factory() returns Builder, .build() mutates and returns self, .run() prints
$t = factory().build().run();

# mixed math via std
$u = std.math.add(1, a + b * c);

# get() returns Iter, .next() returns `add` as a first-class function, called with (a, b)
$v = (get().next())(a, b);

# final side-effect call
std.debug.printLn(
    "a={i}, b={i}, c={i}, result={i}",
    a,
    b,
    c,
    a + b * c
);
