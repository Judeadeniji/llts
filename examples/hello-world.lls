@const $std = @import("std/index");
@const $mem = @import("std/mem");

# Pass arena for values that escape functions (`@new`). Allocator is library-side;
# `@new` is the compiler intrinsic that allocates into it.
$heap = mem.create(0);

@func add(x: int, y: int) {
    return x + y;
}

# Returns `add` as a first-class function value
@func getAdder(n: int) {
    return add;
}

@struct Builder {
    value: int;

    @func build(self) {
        self.value = self.value + 1;
        return self;
    }

    @func run(self) {
        std.fmt.printf("builder result = {i}\n", self.value);
        return self.value;
    }
}

@func factory() {
    $b = @new(heap, Builder);
    b.value = 10;
    return b;
}

@struct Iter {
    value: int;

    @func next(self) {
        return add;
    }
}

@func get() {
    $i = @new(heap, Iter);
    i.value = 0;
    return i;
}

# literals + registers
@const $msg = "Hello, LLTS!";
@const $a = 10;
@const $b = 20;
@const $c = 3;

# basic binary ops
@const $d = a + b;
@const $e = a * b + c;
@const $f = a + b * c;
@const $g = (a + b) * c;

# unary ops
@const $h = -a;
@const $i = !b;

# chained binary ops
@const $j = 1 + a + b + c;
@const $k = a * b / c % 2;

$add = std.math.add;

# function calls
$m = add(a, b);
$n = add(1, add(a, b));

# member access
$o = std.fmt;
$p = std.fmt.printf;

# call + member chaining
$q = std.fmt.printf("sum = {i}\n", a + b);
$r = std.fmt.printf("calc = {i}\n", add(a, b) * c);

# currying / call chaining: getAdder returns `add` as a first-class function
$s = getAdder(1)(2, 3);

# method chaining: factory() returns Builder, .build() mutates and returns self, .run() prints
$t = factory().build().run();

# mixed math via std
$u = std.math.add(1, a + b * c);

# get() returns Iter, .next() returns `add` as a first-class function, called with (a, b)
$v = (get().next())(a, b);

# final side-effect call
std.fmt.printf(
    "a={i}, b={i}, c={i}, result={i}\n",
    a,
    b,
    c,
    a + b * c
);

pub @func main() {
    # Reference top-level bindings so unused-analysis stays quiet
    _ = heap;
    _ = msg;
    _ = d;
    _ = e;
    _ = f;
    _ = g;
    _ = h;
    _ = i;
    _ = j;
    _ = k;
    _ = add;
    _ = getAdder;
    _ = m;
    _ = n;
    _ = o;
    _ = p;
    _ = q;
    _ = r;
    _ = s;
    _ = t;
    _ = u;
    _ = v;
}
