{
  "scopeName": "source.lls",
  "patterns": [
    {
      "match": "#.*$",
      "name": "comment.line.number-sign.lls"
    },
    {
      "name": "string.quoted.double.lls",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.lls" }]
    }
  ]
}
