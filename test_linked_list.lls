$mem = @import("std/mem");
$debug = @import("std/debug");

@struct Node {
    value: int;
    next: any;
}

pub @func main() {
    debug.printLn("Building a linked list of 400,000 nodes...");
    
    $arena = mem.create(0);
    
    $head = @new(arena, Node{ value: 0, next: 0 });
    $curr = head;
    
    @for(1..400000) |i| {
        $n = @new(arena, Node{ value: i, next: 0 });
        curr.next = n;
        curr = n;
    }
    
    debug.printLn("Done.");
}
