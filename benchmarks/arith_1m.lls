# 1M mixed-arithmetic benchmark (LLTS).
# Exercises binArith / binBitwise dispatch and the loop step counter.
# Use: llts run --release benchmarks/arith_1m.lls

@const $std = @import("std/index");

@const $N = 1000000;
$acc = 1;
$start = std.time.Now();

@for (0..N) |i| {
    acc = acc + i;
    acc = acc * 2;
    acc = acc - i;
    acc = acc / 2;
}

$elapsed_ms = std.time.Milliseconds(std.time.Since(start));

print("llts-arith:", elapsed_ms, "ms", "acc=", acc);

pub @func main() {}
